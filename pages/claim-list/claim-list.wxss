page {
  background: #F5F1E8;
}
.list-page {
  min-height: 100vh;
  padding-bottom: 80rpx;
  box-sizing: border-box;
  background: #F5F1E8;
}

/* ===== 顶部导航 ===== */
.navbar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 30rpx;
}
.nav-back {
  font-size: 56rpx;
  color: #A02828;
  width: 60rpx;
  line-height: 1;
}
.nav-placeholder { width: 60rpx; }

/* ===== 标题区 ===== */
.header {
  padding: 20rpx 30rpx 24rpx;
}
.title-row {
  display: flex;
  align-items: center;
}
.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #2A2A2A;
}
.count-badge {
  margin-left: 16rpx;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  background: rgba(160,40,40,0.1);
  color: #A02828;
  border-radius: 20rpx;
  font-weight: 500;
}
.tagline {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8B7A5A;
  letter-spacing: 1rpx;
  line-height: 1.6;
}

/* ===== 通知条 ===== */
.notice-bar {
  display: flex;
  align-items: center;
  margin: 0 30rpx 24rpx;
  padding: 20rpx 24rpx;
  background: rgba(160,40,40,0.07);
  border: 1rpx solid rgba(160,40,40,0.15);
  border-radius: 12rpx;
}
.notice-icon {
  font-size: 30rpx;
  margin-right: 14rpx;
}
.notice-text {
  flex: 1;
  font-size: 24rpx;
  color: #8C2424;
  letter-spacing: 0.5rpx;
}
.notice-close {
  margin-left: 12rpx;
  color: #C4A8A8;
  font-size: 28rpx;
  padding: 0 8rpx;
}

/* ===== 列表 ===== */
.claim-list {
  padding: 0 30rpx;
}

/* 空状态 */
.empty {
  margin: 40rpx 0;
  padding: 80rpx 30rpx;
  background: #fff;
  border-radius: 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.empty-emoji { font-size: 120rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 30rpx; font-weight: 600; color: #2A2A2A; margin-bottom: 12rpx; }
.empty-sub { font-size: 24rpx; color: #8B7A5A; letter-spacing: 1rpx; }

/* 卡片 */
.claim-card {
  display: flex;
  align-items: stretch;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
  overflow: hidden;
}

.card-left {
  flex: 1;
  padding: 28rpx 24rpx 24rpx;
}
.card-right {
  width: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #F5EDD8 0%, #E8D9B6 100%);
  padding: 16rpx 10rpx;
}
.jar-thumb {
  width: 100rpx;
  height: 130rpx;
}

/* 编号行 */
.code-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.dot.sleeping { background: #C4B59A; }
.dot.active {
  background: #2E8B2A;
  box-shadow: 0 0 0 4rpx rgba(60,160,60,0.2);
}
.ready-sym {
  font-size: 28rpx;
  color: #AAAAAA;
  margin-right: 12rpx;
  line-height: 1;
}
.code {
  font-size: 34rpx;
  font-weight: 700;
  color: #8C2424;
  letter-spacing: 2rpx;
}
.default-badge {
  margin-left: 14rpx;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  background: rgba(160,40,40,0.12);
  color: #A02828;
  border-radius: 16rpx;
}

/* 系列 + 状态标签行 */
.meta-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}
.series-text {
  font-size: 24rpx;
  color: #6B5A4A;
  flex: 1;
}
.status-pill {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}
.status-pill.sleeping {
  background: rgba(180,165,140,0.18);
  color: #8B7A5A;
}
.status-pill.active {
  background: rgba(60,140,50,0.12);
  color: #2E7A26;
}
.status-pill.ready {
  background: rgba(180,180,180,0.15);
  color: #888;
}

/* 陈酿天数 */
.aging-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}
.aging-label {
  font-size: 22rpx;
  color: #8B7A5A;
  margin-right: 8rpx;
}
.aging-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #8C2424;
  letter-spacing: 1rpx;
}
.aging-unit {
  font-size: 22rpx;
  color: #8B7A5A;
}

/* 按钮行 */
.btn-row {
  display: flex;
  gap: 16rpx;
}
.card-btn {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 24rpx;
  border-radius: 30rpx;
}

/* 已设为首页 — 填充灰 */
.filled-dim {
  background: rgba(180,165,140,0.18);
  color: #B4A58C;
}

/* 设为首页 — 描边红 */
.outline {
  border: 1rpx solid #A02828;
  color: #A02828;
}

/* 查看详情→ — 纯文字红 */
.text-red {
  color: #A02828;
  font-weight: 600;
}

/* 申请开坛 — 填充深红 */
.filled-red {
  background: #A02828;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(140,36,36,0.25);
}

/* ===== 底部 ===== */
.footer {
  margin: 60rpx 30rpx 0;
  text-align: center;
}
.footer-deco {
  font-size: 24rpx;
  color: #B4A58C;
  letter-spacing: 6rpx;
  margin-bottom: 28rpx;
}
.new-claim-btn {
  width: 60%;
  margin: 0 auto;
  height: 88rpx;
  line-height: 88rpx;
  background: transparent;
  border: 2rpx solid #A02828;
  color: #A02828;
  border-radius: 50rpx;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}
.new-claim-btn::after { border: none; }
.new-claim-btn:active { transform: scale(0.98); }
