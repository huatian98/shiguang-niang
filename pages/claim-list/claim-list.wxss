.list-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.header {
  padding: 30rpx 30rpx 20rpx;
}
.title-row {
  display: flex;
  align-items: baseline;
}
.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2A2A2A;
}
.count {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #8B7A5A;
}
.tagline {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6B5A4A;
  letter-spacing: 2rpx;
}

.notice {
  display: flex;
  align-items: center;
  margin: 0 30rpx 24rpx;
  padding: 18rpx 24rpx;
  background: #FFF8E8;
  border: 1rpx solid #F0D89F;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #8B6F2A;
}
.notice-icon {
  margin-right: 12rpx;
  color: #C68F1E;
  font-size: 28rpx;
}
.notice-text { flex: 1; }
.notice-close {
  margin-left: 12rpx;
  color: #B5A480;
  font-size: 28rpx;
  padding: 0 8rpx;
}

.claim-list {
  padding: 0 30rpx;
}

.empty {
  margin: 60rpx 0;
  padding: 80rpx 30rpx;
  background: #fff;
  border-radius: 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.empty-emoji {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}
.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2A2A2A;
  margin-bottom: 12rpx;
}
.empty-sub {
  font-size: 24rpx;
  color: #8B7A5A;
  letter-spacing: 1rpx;
}
.claim-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  position: relative;
  overflow: hidden;
}
.claim-card.sleeping::before { background: #C4B59A; }
.claim-card.active::before { background: #2E6F2A; }
.claim-card.ready::before { background: #C68F1E; }
.claim-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 18rpx;
  border-bottom: 1rpx dashed rgba(0,0,0,0.06);
}
.code-block {
  display: flex;
  align-items: center;
}
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}
.dot.sleeping { background: #C4B59A; }
.dot.active   { background: #2E6F2A; box-shadow: 0 0 8rpx rgba(60,160,60,0.6); }
.dot.ready    { background: #C68F1E; box-shadow: 0 0 8rpx rgba(220,150,30,0.6); }

.code {
  font-size: 34rpx;
  font-weight: 700;
  color: #8C2424;
  letter-spacing: 1rpx;
}
.default-badge {
  margin-left: 14rpx;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  background: rgba(160,40,40,0.12);
  color: #A02828;
  border-radius: 16rpx;
}

.status-text {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 18rpx;
}
.status-text.sleeping {
  background: rgba(180,165,140,0.18);
  color: #8B7A5A;
}
.status-text.active {
  background: rgba(60,140,50,0.15);
  color: #2E6F2A;
}
.status-text.ready {
  background: rgba(200,140,30,0.15);
  color: #B85A20;
}

.card-mid {
  padding: 18rpx 0 8rpx;
}
.meta-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}
.meta-label {
  width: 80rpx;
  font-size: 24rpx;
  color: #8B7A5A;
}
.meta-value {
  flex: 1;
  font-size: 26rpx;
  color: #4A3A2A;
}
.meta-value.highlight {
  font-size: 28rpx;
  color: #8C2424;
  font-weight: 600;
}

.card-bot {
  display: flex;
  gap: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed rgba(0,0,0,0.06);
}
.card-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 24rpx;
  border-radius: 32rpx;
  background: rgba(160,40,40,0.08);
  color: #A02828;
}
.card-btn.primary {
  background: #A02828;
  color: #fff;
}

.footer {
  margin: 60rpx 30rpx 0;
  text-align: center;
}
.footer-text {
  font-size: 26rpx;
  color: #8B7A5A;
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
}
.claim-btn {
  width: 60%;
  margin: 0 auto;
  height: 88rpx;
  line-height: 88rpx;
  background: transparent;
  border: 2rpx solid #A02828;
  color: #A02828;
  border-radius: 50rpx;
  font-size: 28rpx;
}
.claim-btn::after { border: none; }
.claim-btn:active { transform: scale(0.98); }
