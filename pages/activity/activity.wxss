.placeholder-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 60rpx 0;
  box-sizing: border-box;
}
.ph-icon {
  font-size: 160rpx;
  margin-bottom: 30rpx;
  filter: grayscale(0.2);
  animation: float 3s ease-in-out infinite;
}
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-10rpx); }
}
.ph-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #2A2A2A;
  letter-spacing: 4rpx;
}
.ph-sub {
  margin-top: 16rpx;
  font-size: 30rpx;
  color: #A02828;
  letter-spacing: 6rpx;
  font-weight: 500;
}
.ph-tip {
  margin-top: 30rpx;
  font-size: 24rpx;
  color: #8B7A5A;
  letter-spacing: 2rpx;
  text-align: center;
  line-height: 1.8;
}
