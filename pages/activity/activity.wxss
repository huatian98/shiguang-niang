.activity-page {
  min-height: 100vh;
  background: #F5F1E8;
  padding-bottom: 100rpx;
  box-sizing: border-box;
}

/* 顶部导航 */
.top-nav {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 28rpx;
}
.nav-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  font-size: 36rpx;
  color: #A02828;
}
.bell { font-size: 32rpx; }
.dot-red {
  position: absolute;
  top: 12rpx;
  right: 14rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #E53;
  box-shadow: 0 0 6rpx rgba(220,60,60,0.6);
}
.nav-brand {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #8C2424;
  letter-spacing: 10rpx;
}

/* 标题区 */
.page-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 10rpx 30rpx 24rpx;
}
.header-en {
  display: block;
  font-size: 20rpx;
  color: #A07A50;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}
.header-zh {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  color: #1A1A1A;
  letter-spacing: 4rpx;
}
.header-actions {
  display: flex;
  gap: 14rpx;
  padding-bottom: 8rpx;
}
.action-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}
.action-btn:active { opacity: 0.7; }

/* 分类标签 */
.tag-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 24rpx;
}
.tag-list {
  display: inline-flex;
  padding: 0 30rpx;
  gap: 16rpx;
}
.tag {
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #6B5A4A;
  background: #fff;
  white-space: nowrap;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.04);
}
.tag-active {
  background: #A02828;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(160,40,40,0.3);
}

/* 活动列表 */
.event-list {
  padding: 0 30rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

/* 活动卡片 */
.event-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.event-card:active { opacity: 0.95; }

/* 封面 */
.event-cover-wrap {
  position: relative;
  width: 100%;
  height: 360rpx;
}
.event-cover {
  width: 100%;
  height: 100%;
  display: block;
}
.cover-mask {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.42);
}

/* 角标 */
.event-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  letter-spacing: 1rpx;
}
.badge-hot   { background: #A02828; color: #FFE6B0; }
.badge-limit { background: rgba(255,255,255,0.92); color: #4A3A2A; }
.badge-ended { background: rgba(50,50,50,0.72); color: #fff; }

/* 卡片内容 */
.event-body {
  padding: 24rpx 26rpx 22rpx;
}
.event-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}
.event-title-ended { color: #8B7A5A; }

.event-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 18rpx;
}
.meta-item {
  font-size: 22rpx;
  color: #8B7A5A;
  letter-spacing: 0.5rpx;
}

/* 底部操作行 */
.event-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 头像组 */
.avatars {
  display: flex;
  gap: -8rpx;
}
.avatar-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #EAD4A4;
  border: 2rpx solid #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 700;
  color: #8C2424;
  margin-right: -10rpx;
}
.avatar-more {
  background: #A02828;
  color: #fff;
}

/* 引言 */
.event-quote {
  font-size: 22rpx;
  color: #A02828;
  font-style: italic;
  flex: 1;
  margin-right: 16rpx;
  line-height: 1.6;
}

/* 已结束说明 */
.event-ended-desc {
  font-size: 22rpx;
  color: #8B7A5A;
  flex: 1;
}

/* 按钮 */
.btn-reserve, .btn-limited {
  background: #A02828;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  padding: 14rpx 30rpx;
  border-radius: 30rpx;
  white-space: nowrap;
  flex-shrink: 0;
}
.btn-reserve:active, .btn-limited:active { opacity: 0.85; }

.btn-review {
  border: 2rpx solid #C4B59A;
  color: #8B7A5A;
  font-size: 24rpx;
  font-weight: 500;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  white-space: nowrap;
  flex-shrink: 0;
}
.btn-review:active { opacity: 0.7; }
