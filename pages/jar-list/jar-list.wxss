.jar-list-page {
  min-height: 100vh;
  background: #F5F1E8;
  padding-bottom: 100rpx;
  box-sizing: border-box;
}

/* 地点标签 */
.location-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 10rpx 0 28rpx;
}
.location-pin { font-size: 26rpx; }
.location-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #A02828;
  letter-spacing: 2rpx;
}
.location-arrow {
  font-size: 28rpx;
  color: #A02828;
  opacity: 0.6;
}

/* 两列网格 */
.jar-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 0 24rpx;
}

/* 酒坛卡片 */
.jar-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 18rpx 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(0,0,0,0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 酒坛图 */
.jar-img-wrap {
  width: 100%;
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FAF5EE;
  border-radius: 14rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}
.jar-img {
  width: 100%;
  height: 100%;
}

/* 编号 */
.jar-code {
  font-size: 20rpx;
  color: #8B7A5A;
  letter-spacing: 0.5rpx;
  margin-bottom: 6rpx;
  align-self: flex-start;
}

/* 村落 */
.jar-village {
  font-size: 24rpx;
  font-weight: 600;
  color: #A02828;
  letter-spacing: 1rpx;
  align-self: flex-start;
  margin-bottom: 4rpx;
}

/* 系列·规格·年份 */
.jar-series {
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 1rpx;
  align-self: flex-start;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

/* 价格 */
.jar-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #A02828;
  align-self: flex-start;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

/* 操作按钮 */
.jar-btns {
  display: flex;
  gap: 12rpx;
  width: 100%;
}
.btn-detail {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #C4B59A;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #6B5A4A;
}
.btn-detail:active { opacity: 0.7; }
.btn-claim {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #A02828;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}
.btn-claim:active { opacity: 0.85; }

/* 占位卡 */
.jar-card-placeholder {
  border: 2rpx dashed #C4B59A;
  background: #FAF5EE;
  box-shadow: none;
  justify-content: center;
  min-height: 380rpx;
  gap: 12rpx;
}
.placeholder-icon {
  font-size: 60rpx;
  opacity: 0.4;
}
.placeholder-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8B7A5A;
  letter-spacing: 2rpx;
}
.placeholder-sub {
  font-size: 22rpx;
  color: #B5A480;
  letter-spacing: 1rpx;
}
.btn-coming {
  margin-top: 8rpx;
  padding: 10rpx 28rpx;
  background: #E8E0D0;
  border-radius: 30rpx;
  font-size: 22rpx;
  color: #B5A480;
  letter-spacing: 1rpx;
}
