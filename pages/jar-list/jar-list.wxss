.list-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.navbar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 30rpx;
  background: #F5F1E8;
}
.nav-back {
  font-size: 56rpx;
  color: #A02828;
  width: 60rpx;
  line-height: 1;
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  color: #2A2A2A;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.nav-placeholder { width: 60rpx; }

.header {
  padding: 20rpx 30rpx 30rpx;
}
.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #8C2424;
  letter-spacing: 4rpx;
}
.sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8B7A5A;
  letter-spacing: 1rpx;
}

.empty {
  margin: 80rpx 30rpx;
  padding: 80rpx 30rpx;
  background: #fff;
  border-radius: 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.empty-emoji {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}
.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2A2A2A;
  margin-bottom: 12rpx;
}
.empty-sub {
  font-size: 24rpx;
  color: #8B7A5A;
}

/* 网格 2 列 */
.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 0 30rpx;
}

.jar-card {
  position: relative;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx 24rpx 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(0,0,0,0.05);
  overflow: hidden;
  transition: transform 0.15s;
}
.jar-card:active {
  transform: scale(0.97);
}
.card-bg {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 200rpx;
  background: linear-gradient(135deg, rgba(160,40,40,0.06), rgba(176,140,80,0.04));
  border-radius: 20rpx 20rpx 50% 50% / 20rpx 20rpx 30rpx 30rpx;
}

.card-jar {
  position: relative;
  display: flex;
  justify-content: center;
  height: 160rpx;
  align-items: center;
}
.jar-mini {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.jar-mini-neck {
  width: 50rpx;
  height: 22rpx;
  background: linear-gradient(180deg, #6B3A1A, #4A2810);
  border-radius: 8rpx 8rpx 2rpx 2rpx;
}
.jar-mini-body {
  width: 130rpx;
  height: 130rpx;
  margin-top: -2rpx;
  background: linear-gradient(135deg, #9B5028 0%, #6E3818 50%, #3D1E08 100%);
  border-radius: 50% 50% 38% 38% / 35% 35% 45% 45%;
  box-shadow:
    inset -10rpx -6rpx 16rpx rgba(0,0,0,0.4),
    inset 8rpx 6rpx 16rpx rgba(255,180,100,0.15),
    0 6rpx 14rpx rgba(80,40,10,0.3);
  position: relative;
}
.jar-mini-body::after {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 22rpx;
  width: 16rpx;
  height: 40rpx;
  background: linear-gradient(180deg, rgba(255,220,180,0.4), transparent);
  border-radius: 50%;
  filter: blur(2rpx);
}

.card-code {
  position: relative;
  font-size: 36rpx;
  font-weight: 700;
  color: #8C2424;
  text-align: center;
  letter-spacing: 1rpx;
  margin-top: 10rpx;
}
.card-series {
  position: relative;
  font-size: 22rpx;
  color: #6B5A4A;
  text-align: center;
  margin-top: 6rpx;
}
.card-cellar {
  position: relative;
  font-size: 22rpx;
  color: #8B7A5A;
  text-align: center;
  margin-top: 8rpx;
}

.card-bottom {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed rgba(160,40,40,0.12);
}
.card-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #8C2424;
}
.card-pick {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  background: #A02828;
  color: #fff;
  border-radius: 20rpx;
  letter-spacing: 1rpx;
}
