<view class="jar-list-page">

  <!-- 地点标签 -->
  <view class="location-bar" bindtap="onLocationTap">
    <text class="location-pin">📍</text>
    <text class="location-text">屏南县 · 古法酿造窖藏</text>
    <text class="location-arrow">›</text>
  </view>

  <!-- 坛位网格 -->
  <view class="jar-grid">

    <view class="jar-card" wx:for="{{list}}" wx:key="id">
      <!-- 酒坛图 -->
      <view class="jar-img-wrap">
        <image class="jar-img" src="{{item.imgSrc}}" mode="aspectFit" />
      </view>
      <!-- 编号 -->
      <view class="jar-code">编号 {{item.code}}</view>
      <!-- 村落 -->
      <view class="jar-village">{{item.cellar_village}}</view>
      <!-- 系列·规格·年份 -->
      <view class="jar-series">{{item.series_name}} · {{item.weight}} · {{item.years}}</view>
      <!-- 价格 -->
      <view class="jar-price">¥{{item.price}}</view>
      <!-- 操作按钮 -->
      <view class="jar-btns">
        <view class="btn-detail" bindtap="onDetail" data-id="{{item.id}}">详情</view>
        <view class="btn-claim" bindtap="onClaim" data-id="{{item.id}}">认领</view>
      </view>
    </view>

    <!-- 占位卡 -->
    <view class="jar-card jar-card-placeholder">
      <view class="placeholder-icon">📜</view>
      <view class="placeholder-title">等待发掘</view>
      <view class="placeholder-sub">更多坛位...</view>
      <view class="btn-coming">敬请期待</view>
    </view>

  </view>

</view>
