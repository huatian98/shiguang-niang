<view class="home-page" style="padding-top: {{statusBarHeight}}px;">

  <!-- ============ 状态 A:未认领 ============ -->
  <block wx:if="{{state === 'not_claimed'}}">
    <!-- 顶部导航 -->
    <view class="top-nav">
      <view class="nav-back" bindtap="onBack">‹</view>
      <view class="nav-brand">時光酿</view>
      <view class="nav-actions">
        <view class="nav-pill" bindtap="onShareMood">分享心情</view>
        <view class="nav-pill" bindtap="onDiary">养情手账</view>
      </view>
    </view>

    <!-- 主视觉:酒坛展示卡 -->
    <view class="hero-card">
      <view class="hero-bg-img"></view>

      <view class="hero-content">
        <view class="hero-left">
          <view class="hero-brand">
            <text class="brand-line">時 光 酿</text>
          </view>
          <view class="code-block">
            <text class="code-prefix">BQ-0827</text>
            <text class="code-divider">|</text>
            <text class="code-num">{{availableCount}}</text>
          </view>
          <view class="series-block">
            <text class="series-name">古法红曲</text>
            <text class="series-divider">|</text>
            <text class="series-year">{{currentYear}}</text>
          </view>
        </view>

        <view class="hero-right">
          <view class="craft-link">
            <text class="craft-link-title">古法酿造工序</text>
            <text class="craft-link-tip">了解技艺 ›</text>
          </view>
        </view>
      </view>

      <!-- 5 个圆环指标 -->
      <view class="ring-stats">
        <view class="ring-item">
          <view class="ring temp" style="--p: {{tempPercent}}; --c: #5B89C9;">
            <view class="ring-inner">
              <text class="ring-val">{{sampleJar.cellar_temp}}</text>
              <text class="ring-unit">°C</text>
            </view>
          </view>
          <text class="ring-label">温度</text>
        </view>
        <view class="ring-item">
          <view class="ring humid" style="--p: {{humidPercent}}; --c: #4A9DA8;">
            <view class="ring-inner">
              <text class="ring-val">{{sampleJar.cellar_humidity}}</text>
              <text class="ring-unit">%</text>
            </view>
          </view>
          <text class="ring-label">湿度</text>
        </view>
        <view class="ring-item">
          <view class="ring lux" style="--p: {{luxPercent}}; --c: #D9A841;">
            <view class="ring-inner">
              <text class="ring-val">{{luxValue}}</text>
              <text class="ring-unit">lux</text>
            </view>
          </view>
          <text class="ring-label">光照</text>
        </view>
        <view class="ring-item">
          <view class="ring rotate" style="--p: {{rotatePercent}}; --c: #888;">
            <view class="ring-inner">
              <text class="ring-val">{{rotateValue}}</text>
              <text class="ring-unit">°</text>
            </view>
          </view>
          <text class="ring-label">旋转角</text>
        </view>
        <view class="ring-item">
          <view class="ring alc" style="--p: {{alcPercent}}; --c: #B85A20;">
            <view class="ring-inner">
              <text class="ring-val">{{alcValue}}</text>
              <text class="ring-unit">度</text>
            </view>
          </view>
          <text class="ring-label">酒精度</text>
        </view>
      </view>
    </view>

    <!-- 大圆 CTA -->
    <view class="cta-area">
      <view class="cta-circle" bindtap="onClaimCTA">
        <view class="cta-inner">
          <text class="cta-icon">☁</text>
          <text class="cta-text-1">开启</text>
          <text class="cta-text-2">云认领</text>
        </view>
      </view>
      <view class="cta-tags">
        <text class="cta-tag">开始陈酿之旅</text>
        <text class="cta-tag">匠心独运</text>
        <text class="cta-tag">古法传承</text>
      </view>
    </view>

    <!-- 古法酿造工序 -->
    <view class="craft-section">
      <view class="craft-head">
        <text class="craft-title">古法酿造工序 →</text>
      </view>
      <view class="craft-grid">
        <view class="craft-card" wx:for="{{craftSteps}}" wx:key="name">
          <image class="craft-img" src="{{item.image}}" mode="aspectFill" />
          <view class="craft-side-label">{{item.label}}</view>
          <view class="craft-text">{{item.desc}}</view>
        </view>
      </view>
    </view>

    <view class="dev-toggle" bindtap="onTogglePreview">⚙ 切换到已认领预览</view>
  </block>

  <!-- ============ 状态 B:已认领 ============ -->
  <block wx:elif="{{state === 'claimed'}}">
    <view class="page-nav">
      <text class="page-nav-title">时光酿</text>
    </view>

    <view class="hero-b">
      <view class="ai-jar">
        <view class="ai-jar-emoji">🍶</view>
        <view class="ai-jar-zzz">z<text class="zzz-2">z</text><text class="zzz-3">Z</text></view>
        <view class="ai-jar-action share">分享心情</view>
        <view class="ai-jar-action diary">养情手账</view>
      </view>

      <view class="hero-b-tags">
        <text class="hero-b-tag">沉味沉淀中</text>
        <text class="hero-b-state">正在静默呼吸</text>
      </view>

      <view class="jar-title">
        {{jar.alias}} · {{jar.code}}
        <text class="jar-aging">已认领 {{agingDays}} 天</text>
      </view>
      <view class="jar-cellar">📍 {{jar.cellar_addr}} · {{jar.cellar_name}}</view>
    </view>

    <view class="metrics-card">
      <view class="metrics-row main">
        <view class="metric-big">
          <text class="m-label">酸碱度</text>
          <text class="m-num">{{metrics.wine_ph}}</text>
          <text class="m-status {{metrics.ph_status === '稳定' ? 'ok' : 'warn'}}">{{metrics.ph_status}}</text>
        </view>
      </view>
      <view class="metrics-grid">
        <view class="m-cell">
          <text class="m-cell-label">窖内温度</text>
          <text class="m-cell-val">{{metrics.in_cellar_temp}}<text class="m-unit">°C</text></text>
        </view>
        <view class="m-cell">
          <text class="m-cell-label">窖内湿度</text>
          <text class="m-cell-val">{{metrics.in_cellar_humidity}}<text class="m-unit">%</text></text>
        </view>
        <view class="m-cell">
          <text class="m-cell-label">窖外温度</text>
          <text class="m-cell-val">{{metrics.out_cellar_temp}}<text class="m-unit">°C</text></text>
        </view>
        <view class="m-cell">
          <text class="m-cell-label">窖外湿度</text>
          <text class="m-cell-val">{{metrics.out_cellar_humidity}}<text class="m-unit">%</text></text>
        </view>
      </view>
    </view>

    <view class="ai-card" bindtap="onAITap">
      <view class="ai-icon">✦</view>
      <view class="ai-content">
        <view class="ai-title">AI 醒酒师交互卡</view>
        <view class="ai-text">{{metrics.ai_narrative}}</view>
        <view class="ai-tip">点击查看完整 ›</view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">📖 黄酒成长故事</text>
      </view>
      <view class="timeline">
        <view class="tl-item {{item.status}}" wx:for="{{timeline}}" wx:key="title" data-idx="{{index}}" bindtap="onTimelineTap">
          <view class="tl-dot">
            <text wx:if="{{item.status === 'done'}}">✓</text>
            <text wx:elif="{{item.status === 'active'}}">⏳</text>
            <text wx:elif="{{item.status === 'lock'}}">🔒</text>
          </view>
          <view class="tl-line" wx:if="{{index !== timeline.length - 1}}"></view>
          <view class="tl-content">
            <view class="tl-row1">
              <text class="tl-title">{{item.title}}</text>
              <text class="tl-date">{{item.date}}</text>
            </view>
            <view class="tl-desc">{{item.desc}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">📚 黄酒成分科普</text>
      </view>
      <view class="comp-list">
        <view class="comp-item" wx:for="{{components}}" wx:key="name">
          <view class="comp-emoji">{{item.emoji}}</view>
          <view class="comp-content">
            <view class="comp-name">{{item.name}}</view>
            <view class="comp-desc">{{item.desc}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="dev-toggle" bindtap="onTogglePreview">⚙ 切换到未认领预览</view>
  </block>

</view>
