<view class="home-page" style="padding-top: {{statusBarHeight}}px;">

  <!-- ============ 状态 A:未认领 ============ -->
  <block wx:if="{{state === 'not_claimed'}}">
    <!-- 顶部导航 -->
    <view class="top-nav">
      <view class="nav-icon" bindtap="onMenu">☰</view>
      <view class="nav-brand">时光酿</view>
      <view class="nav-icon" bindtap="onNotice">
        <text class="bell">🔔</text>
        <view class="dot-red"></view>
      </view>
    </view>

    <!-- 主视觉卡片 -->
    <view class="hero-card">
      <view class="hero-row1">
        <text class="hero-title">样坛:红曲黄酒</text>
        <view class="hero-suggest">
          <text class="suggest-label">建议窖藏</text>
          <text class="suggest-num">{{availableCount}}+</text>
        </view>
      </view>
      <view class="hero-status">
        <view class="status-dot"></view>
        <text class="status-text">静候认领中...</text>
      </view>

      <view class="hero-stats">
        <view class="stat-cell">
          <view class="stat-icon temp">🌡</view>
          <view class="stat-content">
            <view class="stat-label">酒窖温度</view>
            <view class="stat-val">{{sampleJar.cellar_temp}}<text class="stat-unit">°C</text></view>
          </view>
        </view>
        <view class="stat-cell">
          <view class="stat-icon ph">💧</view>
          <view class="stat-content">
            <view class="stat-label">酸度</view>
            <view class="stat-val">{{sampleJar.cellar_ph}}</view>
          </view>
        </view>
      </view>

      <view class="hero-decoration">🍷</view>
    </view>

    <!-- 大圆 CTA -->
    <view class="cta-area">
      <view class="cta-circle" bindtap="onClaimCTA">
        <view class="cta-inner">
          <text class="cta-icon">☁</text>
          <text class="cta-text">开启云认领</text>
        </view>
      </view>
      <view class="cta-hint">拥有一坛属于自己的时光陈酿</view>
    </view>

    <!-- 古法酿造工序(横滑)-->
    <view class="craft-section">
      <view class="craft-head">
        <text class="craft-title">古法酿造工序</text>
        <text class="craft-more" bindtap="onCraftMore">了解技艺 ›</text>
      </view>
      <scroll-view scroll-x="{{true}}" class="craft-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="craft-list">
          <view class="craft-card" wx:for="{{craftSteps}}" wx:key="label">
            <view class="craft-no">{{index + 1}}</view>
            <image class="craft-img" src="{{item.image}}" mode="aspectFill" />
            <view class="craft-text">
              <view class="craft-name">{{item.label}}</view>
              <view class="craft-desc">{{item.desc}}</view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="dev-toggle" bindtap="onTogglePreview">⚙ 切换到已认领预览</view>
  </block>

  <!-- ============ 状态 B:已认领 ============ -->
  <block wx:elif="{{state === 'claimed'}}">
    <!-- 顶部导航 -->
    <view class="top-nav">
      <view class="nav-icon" bindtap="onMenu">☰</view>
      <view class="nav-brand">时光酿</view>
      <view class="nav-icon" bindtap="onNotice">
        <text class="bell">🔔</text>
      </view>
    </view>

    <!-- 酒坛主视觉区 -->
    <view class="hero-b">
      <image class="jar-state-img" src="{{jarStateImg}}" mode="aspectFill" />
      <view class="invite-btn" bindtap="onInvite">✦ 邀友同酿</view>
      <view class="status-pills">
        <text wx:if="{{jarState === 'acid'}}" class="pill pill-red">⚠️ 酸度升高</text>
        <text wx:elif="{{jarState === 'sleep'}}" class="pill pill-orange">✦ 安心沉睡中</text>
        <text wx:else class="pill pill-orange">✦ {{metrics.breathing_state}}</text>
        <text wx:if="{{jarState === 'acid'}}" class="pill pill-gray">褪去一抹青涩</text>
        <text wx:elif="{{jarState === 'sleep'}}" class="pill pill-gray">💤 深度休眠期</text>
        <text wx:else class="pill pill-green">🛡 正在静默呼吸</text>
      </view>
    </view>

    <!-- 酒坛信息行 -->
    <view class="jar-info-row">
      <view class="jar-info-left">
        <view class="jar-code-text">{{jar.series}} · {{jar.code}}</view>
        <view class="jar-addr-text">📍 {{jar.cellar_addr}} · {{jar.cellar_name}}</view>
      </view>
      <view class="aging-badge">已认领 {{agingDays}} 天</view>
    </view>

    <!-- 三格指标卡 -->
    <view class="metrics-three">
      <view class="m3-card">
        <view class="m3-icon">🧪</view>
        <view class="m3-title">酸碱平衡</view>
        <view class="m3-val {{metrics.ph_status === '偏高' ? 'm3-warn' : ''}}">{{metrics.wine_ph}}</view>
        <view class="m3-sub {{metrics.ph_status === '偏高' ? 'm3-sub-warn' : 'm3-sub-ok'}}">状态：{{metrics.ph_status}}</view>
      </view>
      <view class="m3-card">
        <view class="m3-icon">🏛</view>
        <view class="m3-title">窖内环境</view>
        <view class="m3-val">{{metrics.in_cellar_temp}}℃</view>
        <view class="m3-sub m3-sub-gray">{{metrics.in_cellar_humidity}}% 湿度</view>
      </view>
      <view class="m3-card">
        <view class="m3-icon">☁️</view>
        <view class="m3-title">外部气候</view>
        <view class="m3-val">{{metrics.out_cellar_temp}}℃</view>
        <view class="m3-sub m3-sub-gray">{{metrics.out_cellar_humidity}}% 湿度</view>
      </view>
    </view>

    <!-- AI 酿酒师感说卡 -->
    <view class="ai-card {{jarState === 'acid' ? 'ai-card-warn' : ''}}" bindtap="onAITap">
      <view class="ai-icon {{jarState === 'acid' ? 'ai-icon-warn' : ''}}">{{jarState === 'acid' ? '⚠️' : '✦'}}</view>
      <view class="ai-content">
        <view class="ai-title {{jarState === 'acid' ? 'ai-title-warn' : ''}}">AI 酿酒师感说</view>
        <view class="ai-text">{{metrics.ai_narrative}}</view>
        <view class="ai-tags">
          <text wx:if="{{jarState === 'acid'}}" class="ai-tag ai-tag-orange">🟠 酸度：偏高关注</text>
          <text wx:elif="{{jarState === 'sleep'}}" class="ai-tag ai-tag-red">🔴 口感推荐：绵柔清冽</text>
          <text wx:else class="ai-tag ai-tag-red">🔴 口感推荐：醇厚回甘</text>
          <text wx:if="{{jarState === 'acid'}}" class="ai-tag ai-tag-green">🟢 趋势：自然回落中</text>
          <text wx:elif="{{jarState === 'sleep'}}" class="ai-tag ai-tag-blue">💤 状态：深度沉眠</text>
          <text wx:else class="ai-tag ai-tag-green">🟢 发酵中：均匀呼吸泡</text>
        </view>
      </view>
    </view>

    <!-- 黄酒成长故事 -->
    <view class="section">
      <view class="section-head">
        <text class="section-icon">📜</text>
        <text class="section-title">黄酒成长故事</text>
      </view>
      <view class="timeline">
        <view class="tl-item" wx:for="{{timeline}}" wx:key="title" data-idx="{{index}}" bindtap="onTimelineTap">
          <!-- 左侧圆点 + 连接线 -->
          <view class="tl-left">
            <view class="tl-dot tl-dot-{{item.status}}">
              <text wx:if="{{item.status === 'done'}}">✓</text>
              <text wx:elif="{{item.status === 'active'}}">⏳</text>
              <text wx:elif="{{item.status === 'lock'}}">🔒</text>
            </view>
            <view class="tl-line" wx:if="{{index !== timeline.length - 1}}"></view>
          </view>
          <!-- 右侧卡片 -->
          <view class="tl-card tl-card-{{item.status}}">
            <view class="tl-card-top">
              <text class="tl-card-title tl-title-{{item.status}}">{{item.title}}</text>
              <text wx:if="{{item.status === 'done'}}" class="tl-status-done">已完成</text>
              <text wx:elif="{{item.status === 'active'}}" class="tl-status-active">进行中</text>
            </view>
            <view wx:if="{{item.desc}}" class="tl-card-desc tl-desc-{{item.status}}">{{item.desc}}</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 黄酒成分科普 -->
    <view class="section">
      <view class="section-head">
        <text class="section-icon">📋</text>
        <text class="section-title">黄酒成分科普</text>
      </view>
      <view class="comp-list">
        <view class="comp-card" wx:for="{{components}}" wx:key="name">
          <view class="comp-icon-wrap">
            <text class="comp-shield">🛡</text>
          </view>
          <view class="comp-content">
            <view class="comp-name">{{item.name}}</view>
            <view class="comp-desc">{{item.desc}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="dev-toggle" bindtap="onTogglePreview">⚙ 切换到未认领预览</view>
  </block>

</view>
