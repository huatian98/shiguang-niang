.home-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  box-sizing: border-box;
  background: #F5F1E8;
}

/* ============ 顶部导航(A 状态用) ============ */
.top-nav {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 28rpx;
}
.nav-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  font-size: 36rpx;
  color: #A02828;
}
.nav-icon .bell {
  font-size: 32rpx;
}
.dot-red {
  position: absolute;
  top: 12rpx;
  right: 14rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #E53;
  box-shadow: 0 0 6rpx rgba(220,60,60,0.6);
}
.nav-brand {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #8C2424;
  letter-spacing: 10rpx;
}

/* ============ B 状态简易顶栏 ============ */
.page-nav {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 30rpx;
}
.page-nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #A02828;
  letter-spacing: 6rpx;
}

/* ============ 主视觉卡片(A 状态)============ */
.hero-card {
  position: relative;
  margin: 16rpx 30rpx 30rpx;
  padding: 32rpx 30rpx 26rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #F4E6CB 0%, #EAD4A4 100%);
  box-shadow: 0 6rpx 20rpx rgba(140,100,40,0.12);
  overflow: hidden;
}

.hero-row1 {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  position: relative;
  z-index: 2;
}
.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #8C2424;
  letter-spacing: 2rpx;
}
.hero-suggest {
  text-align: right;
}
.suggest-label {
  display: block;
  font-size: 22rpx;
  color: #6B5A4A;
  margin-bottom: 4rpx;
}
.suggest-num {
  font-size: 50rpx;
  font-weight: 700;
  color: #8C2424;
  letter-spacing: 1rpx;
  line-height: 1;
}

.hero-status {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  position: relative;
  z-index: 2;
}
.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #5DAA4A;
  margin-right: 10rpx;
  box-shadow: 0 0 6rpx rgba(90,170,70,0.6);
}
.status-text {
  font-size: 22rpx;
  color: #8B7A5A;
}

.hero-stats {
  margin-top: 26rpx;
  display: flex;
  gap: 18rpx;
  position: relative;
  z-index: 2;
}
.stat-cell {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  background: rgba(255,255,255,0.75);
  border-radius: 14rpx;
  box-shadow: 0 2rpx 6rpx rgba(140,100,40,0.04);
}
.stat-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(160,40,40,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  font-size: 30rpx;
}
.stat-content {
  flex: 1;
}
.stat-label {
  font-size: 22rpx;
  color: #6B5A4A;
  margin-bottom: 2rpx;
}
.stat-val {
  font-size: 36rpx;
  font-weight: 700;
  color: #2A2A2A;
  line-height: 1;
}
.stat-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #6B5A4A;
  margin-left: 4rpx;
}

.hero-decoration {
  position: absolute;
  right: 24rpx;
  bottom: 16rpx;
  font-size: 140rpx;
  opacity: 0.18;
  z-index: 1;
  pointer-events: none;
}

/* ============ 大圆 CTA ============ */
.cta-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 50rpx 0 40rpx;
}
.cta-circle {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #C73838 0%, #8C2424 60%, #6A1818 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 12rpx 32rpx rgba(140,36,36,0.35),
    inset 0 -10rpx 20rpx rgba(0,0,0,0.18),
    inset 0 8rpx 18rpx rgba(255,255,255,0.16);
}
.cta-circle:active {
  transform: scale(0.97);
}
.cta-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #FFE6B0;
}
.cta-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
  width: 64rpx;
  height: 64rpx;
  border: 2rpx solid rgba(255,230,176,0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cta-text {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
}
.cta-hint {
  margin-top: 30rpx;
  font-size: 24rpx;
  color: #6B5A4A;
  letter-spacing: 2rpx;
}

/* ============ 古法工序横滑 ============ */
.craft-section {
  margin: 20rpx 0 0;
}
.craft-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx 20rpx;
}
.craft-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2A2A2A;
  letter-spacing: 2rpx;
}
.craft-more {
  font-size: 24rpx;
  color: #A02828;
}
.craft-scroll {
  width: 100%;
  white-space: nowrap;
}
.craft-list {
  display: inline-flex;
  padding: 0 30rpx;
  gap: 20rpx;
}
.craft-card {
  position: relative;
  flex-shrink: 0;
  width: 340rpx;
  background: #fff;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 16rpx rgba(140,100,40,0.08);
}
.craft-no {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #A02828;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  z-index: 2;
  box-shadow: 0 4rpx 8rpx rgba(140,36,36,0.3);
}
.craft-img {
  width: 100%;
  height: 360rpx;
  display: block;
}
.craft-text {
  padding: 18rpx 20rpx 22rpx;
  background: #fff;
}
.craft-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #8C2424;
  margin-bottom: 6rpx;
  letter-spacing: 2rpx;
}
.craft-desc {
  font-size: 22rpx;
  color: #4A3A2A;
  line-height: 1.6;
  white-space: normal;
}

/* 开发期临时切换 */
.dev-toggle {
  margin: 60rpx 30rpx 30rpx;
  padding: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #888;
  background: rgba(0,0,0,0.04);
  border-radius: 30rpx;
}

/* ============ 状态 B:已认领 ============ */
.hero-b {
  position: relative;
  margin: 30rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #FAF1DC 0%, #EFE2C0 100%);
  box-shadow: 0 6rpx 20rpx rgba(140,100,40,0.1);
}

.ai-jar {
  position: relative;
  height: 360rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ai-jar-emoji {
  font-size: 240rpx;
  filter: drop-shadow(0 8rpx 16rpx rgba(0,0,0,0.15));
  animation: breathe 4s ease-in-out infinite;
}
@keyframes breathe {
  0%, 100% { transform: scale(1); }
  50%      { transform: scale(1.05); }
}
.ai-jar-zzz {
  position: absolute;
  top: 40rpx;
  right: 60rpx;
  font-size: 36rpx;
  color: #A02828;
  font-style: italic;
  font-weight: 700;
}
.zzz-2 { font-size: 28rpx; margin-left: 4rpx; }
.zzz-3 { font-size: 22rpx; margin-left: 4rpx; }
.ai-jar-action {
  position: absolute;
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(160,40,40,0.12);
  color: #A02828;
}
.ai-jar-action.share { left: 40rpx; bottom: 30rpx; }
.ai-jar-action.diary { right: 40rpx; bottom: 30rpx; }

.hero-b-tags {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.hero-b-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  background: #A02828;
  color: #fff;
  border-radius: 20rpx;
  margin-right: 16rpx;
}
.hero-b-state {
  font-size: 24rpx;
  color: #6B5A4A;
}

.jar-title {
  display: flex;
  align-items: baseline;
  font-size: 36rpx;
  font-weight: 700;
  color: #8C2424;
  margin-top: 16rpx;
}
.jar-aging {
  margin-left: auto;
  font-size: 22rpx;
  color: #8B7A5A;
  font-weight: 400;
}
.jar-cellar {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6B5A4A;
}

.metrics-card {
  margin: 30rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}
.metrics-row.main {
  padding-bottom: 24rpx;
  margin-bottom: 24rpx;
  border-bottom: 1rpx dashed rgba(140,36,36,0.18);
}
.metric-big {
  display: flex;
  align-items: baseline;
}
.m-label {
  font-size: 26rpx;
  color: #6B5A4A;
  margin-right: auto;
}
.m-num {
  font-size: 64rpx;
  font-weight: 700;
  color: #8C2424;
  letter-spacing: 1rpx;
}
.m-status {
  margin-left: 16rpx;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}
.m-status.ok {
  background: rgba(60,130,50,0.18);
  color: #2E6F2A;
}
.m-status.warn {
  background: rgba(200,90,40,0.18);
  color: #B85A20;
}

.metrics-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.m-cell {
  background: #FAF5E8;
  padding: 22rpx;
  border-radius: 14rpx;
}
.m-cell-label {
  display: block;
  font-size: 22rpx;
  color: #6B5A4A;
  margin-bottom: 8rpx;
}
.m-cell-val {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #2A2A2A;
}
.m-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #6B5A4A;
  margin-left: 4rpx;
}

.ai-card {
  display: flex;
  margin: 0 30rpx 30rpx;
  padding: 26rpx 28rpx;
  background: linear-gradient(135deg, #FAF1DC, #EFE2C0);
  border-left: 6rpx solid #A02828;
  border-radius: 14rpx;
}
.ai-card:active { opacity: 0.85; }
.ai-icon {
  font-size: 40rpx;
  margin-right: 18rpx;
  color: #A02828;
  line-height: 1;
}
.ai-content { flex: 1; }
.ai-title {
  font-size: 26rpx;
  color: #A02828;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.ai-text {
  font-size: 26rpx;
  color: #4A3A2A;
  line-height: 1.6;
}
.ai-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #A02828;
}

/* B 状态:section 标题(成长故事/成分科普) */
.section { margin-top: 30rpx; }
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx 20rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2A2A2A;
  letter-spacing: 1rpx;
}

/* 时间线 */
.timeline {
  margin: 0 30rpx;
  padding: 30rpx 30rpx 10rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.tl-item {
  position: relative;
  padding: 0 0 36rpx 60rpx;
}
.tl-item:last-child { padding-bottom: 10rpx; }
.tl-dot {
  position: absolute;
  left: 0;
  top: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #C4B59A;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  z-index: 2;
}
.tl-item.done .tl-dot { background: #2E6F2A; }
.tl-item.active .tl-dot { background: #A02828; }
.tl-item.lock .tl-dot { background: #C4B59A; }
.tl-line {
  position: absolute;
  left: 19rpx;
  top: 40rpx;
  width: 2rpx;
  bottom: -10rpx;
  background: #E8DCC0;
}
.tl-row1 {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.tl-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2A2A2A;
}
.tl-item.lock .tl-title { color: #B5A480; }
.tl-date {
  font-size: 22rpx;
  color: #8B7A5A;
}
.tl-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6B5A4A;
  line-height: 1.5;
}

/* 成分卡 */
.comp-list {
  margin: 0 30rpx;
}
.comp-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fff;
  border-radius: 14rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.comp-emoji {
  font-size: 44rpx;
  margin-right: 20rpx;
}
.comp-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2A2A2A;
  margin-bottom: 4rpx;
}
.comp-desc {
  font-size: 22rpx;
  color: #6B5A4A;
  line-height: 1.5;
}
