.home-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  box-sizing: border-box;
  background: #F5F1E8;
}

/* ============ 顶部导航(A 状态用) ============ */
.top-nav {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
}
.nav-back {
  font-size: 56rpx;
  color: #2A2A2A;
  width: 60rpx;
  line-height: 1;
}
.nav-brand {
  flex: 1;
  text-align: left;
  margin-left: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #8C2424;
  letter-spacing: 6rpx;
}
.nav-actions {
  display: flex;
  gap: 12rpx;
}
.nav-pill {
  padding: 10rpx 22rpx;
  font-size: 22rpx;
  background: #A02828;
  color: #fff;
  border-radius: 30rpx;
  letter-spacing: 1rpx;
}

/* ============ B 状态简易顶栏 ============ */
.page-nav {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 30rpx;
}
.page-nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #A02828;
  letter-spacing: 6rpx;
}

/* ============ 主视觉卡片(A 状态)============ */
.hero-card {
  position: relative;
  margin: 20rpx 30rpx 30rpx;
  padding: 40rpx 30rpx 30rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #F4E6CB 0%, #EAD4A4 100%);
  box-shadow: 0 6rpx 20rpx rgba(140,100,40,0.12);
  overflow: hidden;
}
.hero-bg-img {
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  background:
    radial-gradient(circle at 88% 25%, rgba(255,210,150,0.35) 0%, transparent 45%),
    radial-gradient(circle at 15% 80%, rgba(160,40,40,0.06) 0%, transparent 50%);
  pointer-events: none;
}
.hero-content {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.hero-left {
  flex: 1;
}
.hero-brand {
  margin-bottom: 28rpx;
}
.brand-line {
  font-size: 26rpx;
  color: rgba(140,36,36,0.5);
  letter-spacing: 12rpx;
  font-weight: 400;
}
.code-block {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.code-prefix {
  font-size: 32rpx;
  color: #6B5A4A;
  font-weight: 500;
}
.code-divider {
  font-size: 28rpx;
  color: #B5A480;
}
.code-num {
  font-size: 60rpx;
  font-weight: 700;
  color: #8C2424;
  letter-spacing: 1rpx;
}
.series-block {
  margin-top: 8rpx;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.series-name {
  font-size: 26rpx;
  color: #6B5A4A;
}
.series-divider {
  font-size: 22rpx;
  color: #B5A480;
}
.series-year {
  font-size: 26rpx;
  color: #6B5A4A;
}

.hero-right {
  text-align: right;
}
.craft-link {
  margin-top: 8rpx;
}
.craft-link-title {
  display: block;
  font-size: 24rpx;
  color: #6B5A4A;
  letter-spacing: 1rpx;
}
.craft-link-tip {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #A02828;
}

/* 5 圆环指标 */
.ring-stats {
  position: relative;
  margin-top: 36rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.ring-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ring {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background:
    conic-gradient(var(--c) calc(var(--p) * 1%), rgba(0,0,0,0.08) 0);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.ring-inner {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #FFF8EE;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 2rpx 6rpx rgba(0,0,0,0.06);
}
.ring-val {
  font-size: 26rpx;
  font-weight: 700;
  color: #2A2A2A;
  line-height: 1;
}
.ring-unit {
  font-size: 18rpx;
  color: #8B7A5A;
  margin-top: 4rpx;
  line-height: 1;
}
.ring-label {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #6B5A4A;
  letter-spacing: 1rpx;
}

/* 大圆 CTA */
.cta-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 30rpx 0;
}
.cta-circle {
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #C73838 0%, #8C2424 60%, #6A1818 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 12rpx 32rpx rgba(140,36,36,0.35),
    inset 0 -10rpx 20rpx rgba(0,0,0,0.18),
    inset 0 8rpx 18rpx rgba(255,255,255,0.16);
  position: relative;
}
.cta-circle::before {
  content: '';
  position: absolute;
  inset: -10rpx;
  border: 2rpx dashed rgba(160,40,40,0.4);
  border-radius: 50%;
  pointer-events: none;
}
.cta-circle:active {
  transform: scale(0.97);
}
.cta-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #FFE6B0;
}
.cta-icon {
  font-size: 56rpx;
  margin-bottom: 10rpx;
}
.cta-text-1 {
  font-size: 32rpx;
  letter-spacing: 8rpx;
  font-weight: 500;
}
.cta-text-2 {
  font-size: 50rpx;
  letter-spacing: 10rpx;
  font-weight: 700;
  margin-top: 8rpx;
}
.cta-tags {
  margin-top: 30rpx;
  display: flex;
  gap: 14rpx;
}
.cta-tag {
  font-size: 22rpx;
  padding: 8rpx 22rpx;
  background: rgba(160,40,40,0.08);
  color: #A02828;
  border-radius: 30rpx;
  letter-spacing: 1rpx;
}

/* 古法工序网格(A 状态) */
.craft-section {
  margin: 30rpx 0 0;
}
.craft-head {
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}
.craft-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2A2A2A;
  letter-spacing: 2rpx;
}
.craft-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 0 30rpx;
}
.craft-card {
  position: relative;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}
.craft-img {
  width: 100%;
  height: 280rpx;
  display: block;
}
.craft-side-label {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: rgba(255,255,255,0.85);
  color: #8C2424;
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  letter-spacing: 4rpx;
  writing-mode: vertical-rl;
  text-orientation: upright;
}
.craft-text {
  padding: 18rpx 20rpx 22rpx;
  font-size: 22rpx;
  color: #4A3A2A;
  line-height: 1.55;
  min-height: 100rpx;
  background: #FAF5E8;
}

/* 开发期临时切换 */
.dev-toggle {
  margin: 60rpx 30rpx 30rpx;
  padding: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #888;
  background: rgba(0,0,0,0.04);
  border-radius: 30rpx;
}

/* ============ 状态 B:已认领 ============ */
.hero-b {
  position: relative;
  margin: 30rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #FAF1DC 0%, #EFE2C0 100%);
  box-shadow: 0 6rpx 20rpx rgba(140,100,40,0.1);
}

.ai-jar {
  position: relative;
  height: 360rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ai-jar-emoji {
  font-size: 240rpx;
  filter: drop-shadow(0 8rpx 16rpx rgba(0,0,0,0.15));
  animation: breathe 4s ease-in-out infinite;
}
@keyframes breathe {
  0%, 100% { transform: scale(1); }
  50%      { transform: scale(1.05); }
}
.ai-jar-zzz {
  position: absolute;
  top: 40rpx;
  right: 60rpx;
  font-size: 36rpx;
  color: #A02828;
  font-style: italic;
  font-weight: 700;
}
.zzz-2 { font-size: 28rpx; margin-left: 4rpx; }
.zzz-3 { font-size: 22rpx; margin-left: 4rpx; }
.ai-jar-action {
  position: absolute;
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(160,40,40,0.12);
  color: #A02828;
}
.ai-jar-action.share { left: 40rpx; bottom: 30rpx; }
.ai-jar-action.diary { right: 40rpx; bottom: 30rpx; }

.hero-b-tags {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.hero-b-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  background: #A02828;
  color: #fff;
  border-radius: 20rpx;
  margin-right: 16rpx;
}
.hero-b-state {
  font-size: 24rpx;
  color: #6B5A4A;
}

.jar-title {
  display: flex;
  align-items: baseline;
  font-size: 36rpx;
  font-weight: 700;
  color: #8C2424;
  margin-top: 16rpx;
}
.jar-aging {
  margin-left: auto;
  font-size: 22rpx;
  color: #8B7A5A;
  font-weight: 400;
}
.jar-cellar {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6B5A4A;
}

.metrics-card {
  margin: 30rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}
.metrics-row.main {
  padding-bottom: 24rpx;
  margin-bottom: 24rpx;
  border-bottom: 1rpx dashed rgba(140,36,36,0.18);
}
.metric-big {
  display: flex;
  align-items: baseline;
}
.m-label {
  font-size: 26rpx;
  color: #6B5A4A;
  margin-right: auto;
}
.m-num {
  font-size: 64rpx;
  font-weight: 700;
  color: #8C2424;
  letter-spacing: 1rpx;
}
.m-status {
  margin-left: 16rpx;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}
.m-status.ok {
  background: rgba(60,130,50,0.18);
  color: #2E6F2A;
}
.m-status.warn {
  background: rgba(200,90,40,0.18);
  color: #B85A20;
}

.metrics-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.m-cell {
  background: #FAF5E8;
  padding: 22rpx;
  border-radius: 14rpx;
}
.m-cell-label {
  display: block;
  font-size: 22rpx;
  color: #6B5A4A;
  margin-bottom: 8rpx;
}
.m-cell-val {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #2A2A2A;
}
.m-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #6B5A4A;
  margin-left: 4rpx;
}

.ai-card {
  display: flex;
  margin: 0 30rpx 30rpx;
  padding: 26rpx 28rpx;
  background: linear-gradient(135deg, #FAF1DC, #EFE2C0);
  border-left: 6rpx solid #A02828;
  border-radius: 14rpx;
}
.ai-card:active { opacity: 0.85; }
.ai-icon {
  font-size: 40rpx;
  margin-right: 18rpx;
  color: #A02828;
  line-height: 1;
}
.ai-content { flex: 1; }
.ai-title {
  font-size: 26rpx;
  color: #A02828;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.ai-text {
  font-size: 26rpx;
  color: #4A3A2A;
  line-height: 1.6;
}
.ai-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #A02828;
}

/* B 状态:section 标题(成长故事/成分科普) */
.section { margin-top: 30rpx; }
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx 20rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2A2A2A;
  letter-spacing: 1rpx;
}

/* 时间线 */
.timeline {
  margin: 0 30rpx;
  padding: 30rpx 30rpx 10rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.tl-item {
  position: relative;
  padding: 0 0 36rpx 60rpx;
}
.tl-item:last-child { padding-bottom: 10rpx; }
.tl-dot {
  position: absolute;
  left: 0;
  top: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #C4B59A;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  z-index: 2;
}
.tl-item.done .tl-dot { background: #2E6F2A; }
.tl-item.active .tl-dot { background: #A02828; }
.tl-item.lock .tl-dot { background: #C4B59A; }
.tl-line {
  position: absolute;
  left: 19rpx;
  top: 40rpx;
  width: 2rpx;
  bottom: -10rpx;
  background: #E8DCC0;
}
.tl-row1 {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.tl-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2A2A2A;
}
.tl-item.lock .tl-title { color: #B5A480; }
.tl-date {
  font-size: 22rpx;
  color: #8B7A5A;
}
.tl-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6B5A4A;
  line-height: 1.5;
}

/* 成分卡 */
.comp-list {
  margin: 0 30rpx;
}
.comp-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fff;
  border-radius: 14rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.comp-emoji {
  font-size: 44rpx;
  margin-right: 20rpx;
}
.comp-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2A2A2A;
  margin-bottom: 4rpx;
}
.comp-desc {
  font-size: 22rpx;
  color: #6B5A4A;
  line-height: 1.5;
}
