.home-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  box-sizing: border-box;
  background: #F5F1E8;
}

/* ============ 顶部导航(A 状态用) ============ */
.top-nav {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 28rpx;
}
.nav-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  font-size: 36rpx;
  color: #A02828;
}
.nav-icon .bell {
  font-size: 32rpx;
}
.dot-red {
  position: absolute;
  top: 12rpx;
  right: 14rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #E53;
  box-shadow: 0 0 6rpx rgba(220,60,60,0.6);
}
.nav-brand {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #8C2424;
  letter-spacing: 10rpx;
}

/* ============ B 状态简易顶栏 ============ */
.page-nav {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 30rpx;
}
.page-nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #A02828;
  letter-spacing: 6rpx;
}

/* ============ 主视觉卡片(A 状态)============ */
.hero-card {
  position: relative;
  margin: 16rpx 30rpx 30rpx;
  padding: 32rpx 30rpx 26rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #F4E6CB 0%, #EAD4A4 100%);
  box-shadow: 0 6rpx 20rpx rgba(140,100,40,0.12);
  overflow: hidden;
}

.hero-row1 {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  position: relative;
  z-index: 2;
}
.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #8C2424;
  letter-spacing: 2rpx;
}
.hero-suggest {
  text-align: right;
}
.suggest-label {
  display: block;
  font-size: 22rpx;
  color: #6B5A4A;
  margin-bottom: 4rpx;
}
.suggest-num {
  font-size: 50rpx;
  font-weight: 700;
  color: #8C2424;
  letter-spacing: 1rpx;
  line-height: 1;
}

.hero-status {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  position: relative;
  z-index: 2;
}
.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #5DAA4A;
  margin-right: 10rpx;
  box-shadow: 0 0 6rpx rgba(90,170,70,0.6);
}
.status-text {
  font-size: 22rpx;
  color: #8B7A5A;
}

.hero-stats {
  margin-top: 26rpx;
  display: flex;
  gap: 18rpx;
  position: relative;
  z-index: 2;
}
.stat-cell {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  background: rgba(255,255,255,0.75);
  border-radius: 14rpx;
  box-shadow: 0 2rpx 6rpx rgba(140,100,40,0.04);
}
.stat-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(160,40,40,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  font-size: 30rpx;
}
.stat-content {
  flex: 1;
}
.stat-label {
  font-size: 22rpx;
  color: #6B5A4A;
  margin-bottom: 2rpx;
}
.stat-val {
  font-size: 36rpx;
  font-weight: 700;
  color: #2A2A2A;
  line-height: 1;
}
.stat-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #6B5A4A;
  margin-left: 4rpx;
}

.hero-decoration {
  position: absolute;
  right: 24rpx;
  bottom: 16rpx;
  font-size: 140rpx;
  opacity: 0.18;
  z-index: 1;
  pointer-events: none;
}

/* ============ 大圆 CTA ============ */
.cta-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 50rpx 0 40rpx;
}
.cta-circle {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #C73838 0%, #8C2424 60%, #6A1818 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 12rpx 32rpx rgba(140,36,36,0.35),
    inset 0 -10rpx 20rpx rgba(0,0,0,0.18),
    inset 0 8rpx 18rpx rgba(255,255,255,0.16);
}
.cta-circle:active {
  transform: scale(0.97);
}
.cta-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #FFE6B0;
}
.cta-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
  width: 64rpx;
  height: 64rpx;
  border: 2rpx solid rgba(255,230,176,0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cta-text {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
}
.cta-hint {
  margin-top: 30rpx;
  font-size: 24rpx;
  color: #6B5A4A;
  letter-spacing: 2rpx;
}

/* ============ 古法工序横滑 ============ */
.craft-section {
  margin: 20rpx 0 0;
}
.craft-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx 20rpx;
}
.craft-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2A2A2A;
  letter-spacing: 2rpx;
}
.craft-more {
  font-size: 24rpx;
  color: #A02828;
}
.craft-scroll {
  width: 100%;
  white-space: nowrap;
}
.craft-list {
  display: inline-flex;
  padding: 0 30rpx;
  gap: 20rpx;
}
.craft-card {
  position: relative;
  flex-shrink: 0;
  width: 340rpx;
  background: #fff;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 16rpx rgba(140,100,40,0.08);
}
.craft-no {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #A02828;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  z-index: 2;
  box-shadow: 0 4rpx 8rpx rgba(140,36,36,0.3);
}
.craft-img {
  width: 100%;
  height: 360rpx;
  display: block;
}
.craft-text {
  padding: 18rpx 20rpx 22rpx;
  background: #fff;
}
.craft-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #8C2424;
  margin-bottom: 6rpx;
  letter-spacing: 2rpx;
}
.craft-desc {
  font-size: 22rpx;
  color: #4A3A2A;
  line-height: 1.6;
  white-space: normal;
}

/* 开发期临时切换 */
.dev-toggle {
  margin: 60rpx 30rpx 30rpx;
  padding: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #888;
  background: rgba(0,0,0,0.04);
  border-radius: 30rpx;
}

/* ============ 状态 B:已认领 ============ */

/* 酒坛主视觉区 */
.hero-b {
  position: relative;
  width: 100%;
  height: 560rpx;
  overflow: hidden;
}
.jar-state-img {
  width: 100%;
  height: 100%;
  display: block;
}
.invite-btn {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(255,248,230,0.92);
  color: #8B5A20;
  font-size: 22rpx;
  font-weight: 600;
  padding: 10rpx 22rpx;
  border-radius: 30rpx;
  letter-spacing: 1rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.12);
}
.status-pills {
  position: absolute;
  bottom: 24rpx;
  left: 0; right: 0;
  display: flex;
  justify-content: center;
  gap: 16rpx;
  padding: 0 30rpx;
}
.pill {
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.pill-orange { background: rgba(255,220,140,0.92); color: #8B4A10; }
.pill-green  { background: rgba(200,240,200,0.92); color: #2A6A2A; }
.pill-red    { background: rgba(255,200,190,0.92); color: #A02828; }
.pill-gray   { background: rgba(220,215,205,0.92); color: #5A5050; }

/* 酒坛信息行 */
.jar-info-row {
  display: flex;
  align-items: center;
  padding: 18rpx 30rpx 10rpx;
}
.jar-info-left { flex: 1; }
.jar-code-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #8C2424;
  letter-spacing: 2rpx;
}
.jar-addr-text {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8B7A5A;
  letter-spacing: 0.5rpx;
}
.aging-badge {
  background: #A02828;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  white-space: nowrap;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

/* 三格指标卡 */
.metrics-three {
  display: flex;
  gap: 14rpx;
  margin: 10rpx 30rpx 0;
}
.m3-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 18rpx 10rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}
.m3-icon { font-size: 32rpx; margin-bottom: 6rpx; }
.m3-title { font-size: 20rpx; color: #8B7A5A; letter-spacing: 0.5rpx; margin-bottom: 6rpx; }
.m3-val {
  font-size: 36rpx;
  font-weight: 700;
  color: #8C2424;
  line-height: 1;
}
.m3-warn { color: #C85A20; }
.m3-sub { font-size: 20rpx; margin-top: 6rpx; }
.m3-sub-ok   { color: #2E7A26; }
.m3-sub-warn { color: #C85A20; }
.m3-sub-gray { color: #8B7A5A; }

/* AI 感说卡 */
.ai-card {
  display: flex;
  margin: 18rpx 30rpx 0;
  padding: 24rpx 26rpx;
  background: #fff;
  border-left: 6rpx solid #A02828;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}
.ai-card:active { opacity: 0.85; }
.ai-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  color: #A02828;
  line-height: 1;
  flex-shrink: 0;
}
.ai-content { flex: 1; }
.ai-title {
  font-size: 24rpx;
  color: #A02828;
  font-weight: 600;
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}
.ai-text {
  font-size: 24rpx;
  color: #4A3A2A;
  line-height: 1.7;
}
.ai-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}
.ai-tag {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 14rpx;
}
.ai-tag-red    { background: rgba(160,40,40,0.1);  color: #A02828; }
.ai-tag-green  { background: rgba(46,122,38,0.1);  color: #2E7A26; }
.ai-tag-orange { background: rgba(200,90,32,0.1);  color: #C85A20; }
.ai-tag-blue   { background: rgba(74,90,154,0.1);  color: #4A5A9A; }

/* AI 卡片 - 酸度偏高警告态 */
.ai-card-warn {
  border-left-color: #C85A20;
}
.ai-icon-warn { color: #C85A20; }
.ai-title-warn { color: #C85A20; }

/* B 状态:section 标题(成长故事/成分科普) */
.section { margin-top: 30rpx; }
.section-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 30rpx 20rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2A2A2A;
  letter-spacing: 1rpx;
}

/* 时间线 */
.timeline {
  margin: 0 30rpx;
  padding: 30rpx 30rpx 10rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.tl-item {
  display: flex;
  gap: 20rpx;
  padding-bottom: 30rpx;
}
.tl-item:last-child { padding-bottom: 0; }

.tl-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}
.tl-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #C4B59A;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  flex-shrink: 0;
}
.tl-dot-done  { background: #2E7A26; }
.tl-dot-active { background: #8C2424; }
.tl-dot-lock  {
  background: #fff;
  border: 2rpx solid #C4B59A;
  color: #C4B59A;
}

.tl-line {
  width: 2rpx;
  flex: 1;
  min-height: 20rpx;
  background: #E8DCC0;
  margin-top: 8rpx;
}

/* 时间线卡片 */
.tl-card {
  flex: 1;
  background: #fff;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 4rpx;
  border: 1rpx solid #EDE8DE;
}
.tl-card-done {
  border-left: 6rpx solid #2E7A26;
  border-color: #EDE8DE;
}
.tl-card-active {
  background: #fff;
  border: 2rpx solid #A02828;
}
.tl-card-lock {
  background: #F8F5EF;
  border-color: #EDE8DE;
  opacity: 0.7;
}
.tl-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.tl-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2A2A2A;
  flex: 1;
  margin-right: 12rpx;
}
.tl-title-done   { color: #6B5A4A; font-weight: 400; }
.tl-title-active { color: #8C2424; }
.tl-title-lock   { color: #B5A480; font-weight: 400; }

.tl-status-done {
  font-size: 20rpx;
  color: #8B7A5A;
  white-space: nowrap;
}
.tl-status-active {
  font-size: 20rpx;
  color: #A02828;
  background: rgba(160,40,40,0.1);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.tl-card-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6B5A4A;
  line-height: 1.6;
}
.tl-desc-done { color: #8B7A5A; }
.tl-desc-lock { color: #B5A480; }

/* 成分卡 */
.comp-list {
  margin: 0 30rpx;
}
.comp-card {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fff;
  border-radius: 14rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.comp-icon-wrap {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(160,40,40,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.comp-shield { font-size: 30rpx; }
.comp-content { flex: 1; }
.comp-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #8C2424;
  margin-bottom: 6rpx;
  letter-spacing: 1rpx;
}
.comp-desc {
  font-size: 22rpx;
  color: #6B5A4A;
  line-height: 1.5;
}
