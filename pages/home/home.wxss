.home-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* ============ 状态 A:未认领 ============ */
.hero-a {
  position: relative;
  margin: 30rpx;
  height: 280rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #F0E5C7, #DCD3B5 60%, #B8AC85);
  box-shadow: 0 6rpx 20rpx rgba(140,100,40,0.1);
}
.hero-bg {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 80% 30%, rgba(255,255,255,0.4), transparent 50%);
  pointer-events: none;
}
.hero-card {
  position: relative;
  padding: 36rpx;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.hero-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.hero-tag {
  font-size: 26rpx;
  color: #6B5A4A;
  background: rgba(255,255,255,0.5);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}
.hero-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #8C2424;
  letter-spacing: 2rpx;
}
.hero-sub {
  font-size: 24rpx;
  color: #8B7A5A;
  margin-top: 12rpx;
}
.hero-stats {
  display: flex;
  gap: 20rpx;
}
.hero-stat {
  flex: 1;
  background: rgba(255,255,255,0.55);
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
}
.stat-label {
  display: block;
  font-size: 22rpx;
  color: #6B5A4A;
}
.stat-val {
  display: block;
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #2A2A2A;
}

.cta-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 60rpx 0 40rpx;
}
.cta-circle {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #C73838 0%, #8C2424 60%, #6A1818 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  box-shadow: 0 12rpx 32rpx rgba(140,36,36,0.3),
              inset 0 -8rpx 16rpx rgba(0,0,0,0.15),
              inset 0 8rpx 16rpx rgba(255,255,255,0.15);
  letter-spacing: 4rpx;
  position: relative;
}
.cta-circle:active {
  transform: scale(0.97);
  box-shadow: 0 6rpx 16rpx rgba(140,36,36,0.4);
}
.cta-icon {
  font-size: 56rpx;
  margin-bottom: 8rpx;
  color: #FFE6B0;
}
.cta-text-1 {
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 6rpx;
}
.cta-text-2 {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  margin-top: 4rpx;
}
.cta-hint {
  margin-top: 30rpx;
  font-size: 24rpx;
  color: #6B5A4A;
  letter-spacing: 2rpx;
}

.section {
  margin-top: 30rpx;
}
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx 20rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2A2A2A;
  letter-spacing: 1rpx;
}
.section-more {
  font-size: 24rpx;
  color: #A02828;
}

.craft-scroll { width: 100%; }
.craft-list {
  display: flex;
  padding: 0 30rpx;
  gap: 20rpx;
}
.craft-item {
  flex-shrink: 0;
  width: 240rpx;
  padding: 24rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
  position: relative;
}
.craft-no {
  position: absolute;
  top: 14rpx;
  right: 16rpx;
  font-size: 22rpx;
  color: #C4B59A;
  font-weight: 600;
}
.craft-emoji {
  font-size: 56rpx;
  text-align: center;
  margin-bottom: 12rpx;
}
.craft-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2A2A2A;
  text-align: center;
  margin-bottom: 8rpx;
}
.craft-desc {
  font-size: 22rpx;
  color: #6B5A4A;
  line-height: 1.5;
  text-align: center;
}

/* 开发期临时切换 */
.dev-toggle {
  margin: 60rpx 30rpx 30rpx;
  padding: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #888;
  background: rgba(0,0,0,0.04);
  border-radius: 30rpx;
}

/* ============ 状态 B:已认领 ============ */
.hero-b {
  position: relative;
  margin: 30rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #FAF1DC 0%, #EFE2C0 100%);
  box-shadow: 0 6rpx 20rpx rgba(140,100,40,0.1);
}

.ai-jar {
  position: relative;
  height: 360rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ai-jar-emoji {
  font-size: 240rpx;
  filter: drop-shadow(0 8rpx 16rpx rgba(0,0,0,0.15));
  animation: breathe 4s ease-in-out infinite;
}
@keyframes breathe {
  0%, 100% { transform: scale(1); }
  50%      { transform: scale(1.05); }
}
.ai-jar-zzz {
  position: absolute;
  top: 40rpx;
  right: 60rpx;
  font-size: 36rpx;
  color: #A02828;
  font-style: italic;
  font-weight: 700;
}
.zzz-2 { font-size: 28rpx; margin-left: 4rpx; }
.zzz-3 { font-size: 22rpx; margin-left: 4rpx; }
.ai-jar-action {
  position: absolute;
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(160,40,40,0.12);
  color: #A02828;
}
.ai-jar-action.share { left: 40rpx; bottom: 30rpx; }
.ai-jar-action.diary { right: 40rpx; bottom: 30rpx; }

.hero-b-tags {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.hero-b-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  background: #A02828;
  color: #fff;
  border-radius: 20rpx;
  margin-right: 16rpx;
}
.hero-b-state {
  font-size: 24rpx;
  color: #6B5A4A;
}

.jar-title {
  display: flex;
  align-items: baseline;
  font-size: 36rpx;
  font-weight: 700;
  color: #8C2424;
  margin-top: 16rpx;
}
.jar-aging {
  margin-left: auto;
  font-size: 22rpx;
  color: #8B7A5A;
  font-weight: 400;
}
.jar-cellar {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6B5A4A;
}

.metrics-card {
  margin: 30rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}
.metrics-row.main {
  padding-bottom: 24rpx;
  margin-bottom: 24rpx;
  border-bottom: 1rpx dashed rgba(140,36,36,0.18);
}
.metric-big {
  display: flex;
  align-items: baseline;
}
.m-label {
  font-size: 26rpx;
  color: #6B5A4A;
  margin-right: auto;
}
.m-num {
  font-size: 64rpx;
  font-weight: 700;
  color: #8C2424;
  letter-spacing: 1rpx;
}
.m-status {
  margin-left: 16rpx;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}
.m-status.ok {
  background: rgba(60,130,50,0.18);
  color: #2E6F2A;
}
.m-status.warn {
  background: rgba(200,90,40,0.18);
  color: #B85A20;
}

.metrics-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.m-cell {
  background: #FAF5E8;
  padding: 22rpx;
  border-radius: 14rpx;
}
.m-cell-label {
  display: block;
  font-size: 22rpx;
  color: #6B5A4A;
  margin-bottom: 8rpx;
}
.m-cell-val {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #2A2A2A;
}
.m-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #6B5A4A;
  margin-left: 4rpx;
}

.ai-card {
  display: flex;
  margin: 0 30rpx 30rpx;
  padding: 26rpx 28rpx;
  background: linear-gradient(135deg, #FAF1DC, #EFE2C0);
  border-left: 6rpx solid #A02828;
  border-radius: 14rpx;
}
.ai-card:active { opacity: 0.85; }
.ai-icon {
  font-size: 40rpx;
  margin-right: 18rpx;
  color: #A02828;
  line-height: 1;
}
.ai-content { flex: 1; }
.ai-title {
  font-size: 26rpx;
  color: #A02828;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.ai-text {
  font-size: 26rpx;
  color: #4A3A2A;
  line-height: 1.6;
}
.ai-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #A02828;
}

/* 时间线 */
.timeline {
  margin: 0 30rpx;
  padding: 30rpx 30rpx 10rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.tl-item {
  position: relative;
  padding: 0 0 36rpx 60rpx;
}
.tl-item:last-child { padding-bottom: 10rpx; }
.tl-dot {
  position: absolute;
  left: 0;
  top: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #C4B59A;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  z-index: 2;
}
.tl-item.done .tl-dot { background: #2E6F2A; }
.tl-item.active .tl-dot { background: #A02828; }
.tl-item.lock .tl-dot { background: #C4B59A; }
.tl-line {
  position: absolute;
  left: 19rpx;
  top: 40rpx;
  width: 2rpx;
  bottom: -10rpx;
  background: #E8DCC0;
}
.tl-row1 {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.tl-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2A2A2A;
}
.tl-item.lock .tl-title { color: #B5A480; }
.tl-date {
  font-size: 22rpx;
  color: #8B7A5A;
}
.tl-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6B5A4A;
  line-height: 1.5;
}

/* 成分卡 */
.comp-list {
  margin: 0 30rpx;
}
.comp-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fff;
  border-radius: 14rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.comp-emoji {
  font-size: 44rpx;
  margin-right: 20rpx;
}
.comp-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2A2A2A;
  margin-bottom: 4rpx;
}
.comp-desc {
  font-size: 22rpx;
  color: #6B5A4A;
  line-height: 1.5;
}
