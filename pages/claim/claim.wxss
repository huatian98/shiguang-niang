.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* 顶部导航 */
.navbar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 30rpx;
  background: #F5F1E8;
}
.nav-close {
  font-size: 40rpx;
  color: #A02828;
  width: 60rpx;
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  color: #A02828;
  font-weight: 500;
  letter-spacing: 4rpx;
}
.nav-placeholder {
  width: 60rpx;
}

/* 酒坛图 + 呼吸状态标 */
.jar-wrap {
  position: relative;
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
  height: 380rpx;
  align-items: center;
}
.jar-shape {
  width: 280rpx;
  height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.jar-neck {
  width: 120rpx;
  height: 50rpx;
  background: linear-gradient(180deg, #6B3A1A, #4A2810);
  border-radius: 12rpx 12rpx 4rpx 4rpx;
  box-shadow: inset 0 -4rpx 8rpx rgba(0,0,0,0.3);
}
.jar-body {
  width: 280rpx;
  height: 310rpx;
  margin-top: -4rpx;
  background: linear-gradient(135deg, #8B4513, #5D2E0A 60%, #3A1A05);
  border-radius: 50% 50% 35% 35% / 30% 30% 40% 40%;
  box-shadow:
    inset -20rpx -10rpx 30rpx rgba(0,0,0,0.4),
    inset 20rpx 10rpx 30rpx rgba(255,180,100,0.15),
    0 8rpx 20rpx rgba(80,40,10,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}
.jar-label {
  color: #F5E0B8;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.5);
}
.breathing-tag {
  position: absolute;
  top: 30rpx;
  right: 60rpx;
  background: rgba(160, 40, 40, 0.92);
  color: #fff;
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  letter-spacing: 1rpx;
}

/* 编号 */
.code {
  text-align: center;
  font-size: 56rpx;
  font-weight: 700;
  color: #8C2424;
  margin-top: 16rpx;
  letter-spacing: 2rpx;
}
.series {
  text-align: center;
  font-size: 26rpx;
  color: #6B5A4A;
  margin-top: 10rpx;
}

/* 切换器 */
.switcher {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin: 24rpx 0;
}
.chip {
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  color: #8B7A5A;
  background: #EEE5D0;
  border-radius: 30rpx;
}
.chip.active {
  background: #A02828;
  color: #fff;
}

/* 实时指标卡片 */
.card {
  position: relative;
  margin: 0 30rpx;
  padding: 36rpx 32rpx 40rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #F0E5C7, #DCD3B5 60%, #B8AC85);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}
.watermark {
  position: absolute;
  top: 50rpx;
  right: 40rpx;
  font-size: 44rpx;
  color: rgba(160, 40, 40, 0.08);
  letter-spacing: 8rpx;
  font-weight: 500;
}
.card-header {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #2A2A2A;
  margin-bottom: 28rpx;
}
.bar {
  width: 6rpx;
  height: 28rpx;
  background: #A02828;
  margin-right: 14rpx;
}
.recorded {
  margin-left: auto;
  font-size: 22rpx;
  color: #8B7A5A;
  font-weight: 400;
}

/* 酸碱度 */
.ph-block {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx dashed rgba(140, 36, 36, 0.18);
  margin-bottom: 24rpx;
}
.ph-label {
  font-size: 26rpx;
  color: #555;
}
.ph-value {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}
.ph-num {
  font-size: 64rpx;
  font-weight: 700;
  color: #8C2424;
  letter-spacing: 1rpx;
}
.ph-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(60, 130, 50, 0.18);
  color: #2E6F2A;
}
.ph-status.warn {
  background: rgba(200, 90, 40, 0.18);
  color: #B85A20;
}

/* 4 个指标方格 */
.metrics-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.metric-cell {
  background: rgba(255, 255, 255, 0.55);
  padding: 22rpx 26rpx;
  border-radius: 14rpx;
}
.metric-label {
  font-size: 24rpx;
  color: #6B5A4A;
  margin-bottom: 10rpx;
}
.metric-num {
  font-size: 42rpx;
  font-weight: 700;
  color: #2A2A2A;
}
.unit {
  font-size: 24rpx;
  font-weight: 400;
  color: #6B5A4A;
  margin-left: 4rpx;
}

/* AI 醒酒师 */
.ai-card {
  display: flex;
  align-items: flex-start;
  margin: 30rpx;
  padding: 26rpx 28rpx;
  background: linear-gradient(135deg, #FAF1DC, #EFE2C0);
  border-left: 6rpx solid #A02828;
  border-radius: 14rpx;
}
.ai-icon {
  font-size: 48rpx;
  margin-right: 18rpx;
  line-height: 1;
}
.ai-content {
  flex: 1;
}
.ai-title {
  font-size: 26rpx;
  color: #A02828;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.ai-text {
  font-size: 26rpx;
  color: #4A3A2A;
  line-height: 1.6;
}

/* 按钮 */
.btns {
  margin-top: 40rpx;
  padding: 0 30rpx;
}
.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  margin-bottom: 24rpx;
}
.btn::after {
  border: none;
}
.btn.primary {
  background: #A02828;
  color: #fff;
}
.btn.outline {
  background: transparent;
  border: 2rpx solid #A02828;
  color: #A02828;
}
