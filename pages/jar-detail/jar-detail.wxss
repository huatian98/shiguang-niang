.detail-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  box-sizing: border-box;
  background: #F5F1E8;
}

.navbar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 30rpx;
  background: #F5F1E8;
}
.nav-close {
  font-size: 40rpx;
  color: #A02828;
  width: 60rpx;
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  color: #A02828;
  font-weight: 500;
  letter-spacing: 4rpx;
}
.nav-placeholder { width: 60rpx; }

/* 真实陶罐照片 */
.jar-stage {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
  padding: 0 30rpx;
}
.jar-photo {
  width: 460rpx;
  height: 580rpx;
  border-radius: 6rpx;
  box-shadow: 0 4rpx 18rpx rgba(60,40,20,0.12);
}

.code {
  text-align: center;
  font-size: 72rpx;
  font-weight: 700;
  color: #8C2424;
  margin-top: 30rpx;
  letter-spacing: 4rpx;
  line-height: 1;
}
.series {
  text-align: center;
  font-size: 28rpx;
  color: #6B5A4A;
  margin-top: 16rpx;
  margin-bottom: 40rpx;
  letter-spacing: 1rpx;
}

.card {
  position: relative;
  margin: 0 30rpx;
  padding: 36rpx 32rpx 30rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #F0E5C7, #DCD3B5 60%, #B8AC85);
  box-shadow: 0 6rpx 18rpx rgba(140,100,40,0.1);
  overflow: hidden;
  min-height: 320rpx;
}
.watermark {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 64rpx;
  color: rgba(160,40,40,0.08);
  letter-spacing: 16rpx;
  font-weight: 500;
  white-space: nowrap;
  pointer-events: none;
}
.card-header {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #2A2A2A;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 2;
}
.bar {
  width: 6rpx;
  height: 28rpx;
  background: #A02828;
  margin-right: 14rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  position: relative;
  z-index: 2;
}
.label {
  color: #4A3A2A;
  font-size: 28rpx;
}
.value {
  color: #2A2A2A;
  font-size: 30rpx;
  font-weight: 600;
  text-align: right;
}

.btns {
  margin-top: 50rpx;
  padding: 0 30rpx;
}
.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  margin-bottom: 24rpx;
}
.btn::after { border: none; }
.btn.primary {
  background: #A02828;
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(140,36,36,0.25);
}
.btn.primary:active { transform: scale(0.98); }
.btn.outline {
  background: transparent;
  border: 2rpx solid #A02828;
  color: #A02828;
}
