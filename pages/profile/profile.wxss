page {
  background: #F5F1E8;
}
.profile-page {
  min-height: 100vh;
  padding-bottom: 80rpx;
  box-sizing: border-box;
  background: #F5F1E8;
}

/* ===== 导航 ===== */
.navbar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 30rpx;
}
.nav-left {
  font-size: 36rpx;
  color: #8B7A5A;
  width: 60rpx;
}
.nav-brand {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #A02828;
  letter-spacing: 6rpx;
}
.nav-right {
  font-size: 36rpx;
  color: #8B7A5A;
  width: 60rpx;
  text-align: right;
}

/* ===== 用户信息 ===== */
.user-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 30rpx 28rpx;
}
.avatar-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #C8864A, #A02828);
  border: 6rpx solid #fff;
  box-shadow: 0 4rpx 18rpx rgba(160,40,40,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}
.avatar-text {
  color: #fff;
  font-size: 52rpx;
  font-weight: 700;
}
.nickname {
  font-size: 38rpx;
  font-weight: 700;
  color: #A02828;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}
.signature {
  font-size: 24rpx;
  color: #8B7A5A;
  letter-spacing: 2rpx;
}

/* ===== 数据统计 ===== */
.stats-row {
  display: flex;
  align-items: center;
  margin: 8rpx 30rpx 36rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #A02828;
  line-height: 1.1;
  margin-bottom: 8rpx;
}
.stat-label {
  font-size: 22rpx;
  color: #8B7A5A;
  letter-spacing: 1rpx;
}
.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(0,0,0,0.06);
}
.medal-icon {
  font-size: 52rpx;
  color: #A02828;
  line-height: 1.1;
  margin-bottom: 8rpx;
}

/* ===== 我的酿造坊 ===== */
.section-title {
  margin: 0 30rpx 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #A02828;
  letter-spacing: 2rpx;
}
.brew-card {
  margin: 0 30rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.brew-row {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
}
.brew-row:active { background: #FAF5E8; }
.brew-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}
.red-bg {
  background: rgba(160,40,40,0.1);
}
.beige-bg {
  background: rgba(200,160,80,0.12);
}
.brew-text { flex: 1; }
.brew-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2A2A2A;
  margin-bottom: 6rpx;
}
.brew-sub {
  font-size: 22rpx;
  color: #8B7A5A;
  letter-spacing: 0.5rpx;
}
.brew-divider {
  height: 1rpx;
  background: rgba(0,0,0,0.04);
  margin: 0 30rpx;
}

/* ===== 通用功能 ===== */
.func-card {
  margin: 0 30rpx 36rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.func-row {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
}
.func-row:active { background: #FAF5E8; }
.func-icon {
  font-size: 36rpx;
  margin-right: 22rpx;
  width: 50rpx;
  text-align: center;
}
.func-label {
  flex: 1;
  font-size: 30rpx;
  color: #2A2A2A;
  font-weight: 500;
}
.row-arrow {
  color: #C4B59A;
  font-size: 34rpx;
}

/* ===== 底部引言 ===== */
.quote {
  text-align: center;
  font-size: 24rpx;
  color: #B5A480;
  letter-spacing: 3rpx;
  font-style: italic;
  margin-top: 20rpx;
}
