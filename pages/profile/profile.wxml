<view class="profile-page" style="padding-top: {{statusBarHeight}}px;">

  <!-- 顶部导航 -->
  <view class="navbar">
    <view class="nav-left">☰</view>
    <text class="nav-brand">时光酿</text>
    <view class="nav-right">🔔</view>
  </view>

  <!-- 用户信息区 -->
  <view class="user-section">
    <view class="avatar-wrap">
      <image class="avatar-img" src="/images/decor/avatar-brewer.png" mode="aspectFill" />
    </view>
    <view class="nickname">{{nickname}}</view>
    <view class="signature">{{signature}}</view>
  </view>

  <!-- 数据统计行 -->
  <view class="stats-row">
    <view class="stat-item">
      <text class="stat-num">{{claimDays}}</text>
      <text class="stat-label">认领天数</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <view class="medal-icon">★</view>
      <text class="stat-label">匠心勋章</text>
    </view>
  </view>

  <!-- 我的酿造坊 -->
  <view class="section-title">我的酿造坊</view>
  <view class="brew-card">
    <view class="brew-row" bindtap="onMyClaims">
      <view class="brew-icon red-bg">🍷</view>
      <view class="brew-text">
        <view class="brew-name">我的认领</view>
        <view class="brew-sub">当前认领 {{claimCount}} 坛红曲酒</view>
      </view>
      <text class="row-arrow">›</text>
    </view>
    <view class="brew-divider"></view>
    <view class="brew-row" bindtap="onMyActivities">
      <view class="brew-icon beige-bg">📅</view>
      <view class="brew-text">
        <view class="brew-name">活动报名记录</view>
        <view class="brew-sub">近 30 天参与 {{activityCount}} 场线下活动</view>
      </view>
      <text class="row-arrow">›</text>
    </view>
  </view>

  <!-- 通用功能 -->
  <view class="func-card">
    <view class="func-row" bindtap="onSettings">
      <text class="func-icon">⚙️</text>
      <text class="func-label">设置</text>
      <text class="row-arrow">›</text>
    </view>
    <view class="brew-divider"></view>
    <view class="func-row" bindtap="onService">
      <text class="func-icon">❓</text>
      <text class="func-label">联系客服</text>
      <text class="row-arrow">›</text>
    </view>
  </view>

  <!-- 底部引言 -->
  <view class="quote">"漫长岁月 唯酒不语"</view>

</view>
