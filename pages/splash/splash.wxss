.splash-page {
  min-height: 100vh;
  background: #F5EFE0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  padding: 0 40rpx 60rpx;
}

/* 品牌区 */
.brand-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
  margin-bottom: 40rpx;
}
.main-title {
  font-size: 96rpx;
  font-weight: 700;
  color: #8C2424;
  letter-spacing: 16rpx;
}
.sub-title {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #8B7A5A;
  letter-spacing: 4rpx;
}

/* 工序卡片 */
.craft-card {
  position: relative;
  width: 100%;
  border-radius: 24rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 8rpx 30rpx rgba(140,100,40,0.10);
}
.craft-img {
  width: 100%;
  height: 560rpx;
  display: block;
}
.craft-label {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #4A3A2A;
  letter-spacing: 2rpx;
  line-height: 1.6;
  background: rgba(255,255,255,0.82);
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
}

/* 说明文字 */
.craft-desc {
  margin-top: 36rpx;
  font-size: 28rpx;
  color: #4A3A2A;
  line-height: 1.8;
  text-align: center;
  letter-spacing: 1rpx;
  padding: 0 10rpx;
}

/* 底部 */
.splash-footer {
  margin-top: auto;
  padding-top: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}
.loading-hint {
  font-size: 24rpx;
  color: #A07A50;
  letter-spacing: 3rpx;
}
.skip-btn {
  padding: 16rpx 60rpx;
  background: rgba(255,255,255,0.7);
  border-radius: 50rpx;
  font-size: 28rpx;
  color: #6B5A4A;
  letter-spacing: 2rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.06);
}
.skip-btn:active { opacity: 0.7; }
