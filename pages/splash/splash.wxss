.splash-page {
  position: relative;
  min-height: 100vh;
  background: linear-gradient(180deg, #F5F1E8 0%, #E8DCC0 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  overflow: hidden;
}

.skip {
  position: absolute;
  top: 110rpx;
  right: 40rpx;
  padding: 10rpx 26rpx;
  font-size: 24rpx;
  color: #6B5A4A;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 30rpx;
  z-index: 10;
}

.content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding-bottom: 120rpx;
}

.brand-mark {
  font-size: 200rpx;
  font-weight: 200;
  color: rgba(160, 40, 40, 0.08);
  letter-spacing: 30rpx;
  margin-bottom: -120rpx;
  line-height: 1;
  user-select: none;
}

.main-title {
  font-size: 100rpx;
  font-weight: 700;
  color: #8C2424;
  letter-spacing: 16rpx;
  text-shadow: 0 4rpx 16rpx rgba(140, 36, 36, 0.15);
}

.sub-title {
  margin-top: 24rpx;
  font-size: 32rpx;
  color: #6B5A4A;
  letter-spacing: 8rpx;
}

.tags {
  margin-top: 60rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #8B7A5A;
  letter-spacing: 2rpx;
}
.tag { padding: 0 4rpx; }
.dot { margin: 0 16rpx; color: #C4B59A; }

.loader {
  margin-top: 160rpx;
  width: 200rpx;
  height: 4rpx;
  background: rgba(160, 40, 40, 0.15);
  border-radius: 4rpx;
  overflow: hidden;
}
.bar {
  height: 100%;
  background: #A02828;
  transition: width 0.2s linear;
}

.hint {
  margin-top: 30rpx;
  font-size: 24rpx;
  color: #8B7A5A;
  letter-spacing: 3rpx;
}

.footer {
  position: absolute;
  bottom: 60rpx;
  font-size: 22rpx;
  color: #B5A480;
  letter-spacing: 2rpx;
}
