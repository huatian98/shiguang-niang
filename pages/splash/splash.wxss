.splash-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: #F5EFE0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.craft-img {
  width: 100%;
  height: 100%;
}

.skip-btn {
  position: absolute;
  bottom: 80rpx;
  right: 40rpx;
  padding: 16rpx 48rpx;
  background: rgba(255,255,255,0.72);
  border-radius: 50rpx;
  font-size: 28rpx;
  color: #6B5A4A;
  letter-spacing: 2rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.08);
}
.skip-btn:active { opacity: 0.7; }
