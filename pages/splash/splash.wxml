<view class="splash-page">

  <!-- 品牌标题 -->
  <view class="brand-area">
    <view class="main-title">时光酿</view>
    <view class="sub-title">非遗技艺 · 红曲黄酒酿造</view>
  </view>

  <!-- 工序轮播卡片 -->
  <swiper
    class="craft-swiper"
    autoplay="{{true}}"
    interval="{{1200}}"
    duration="{{400}}"
    circular="{{false}}"
    current="{{currentFrame}}"
    bindchange="onSwiperChange"
  >
    <swiper-item wx:for="{{frames}}" wx:key="image">
      <view class="craft-card">
        <image class="craft-img" src="{{item.image}}" mode="aspectFill" lazy-load="{{false}}" />
      </view>
    </swiper-item>
  </swiper>

  <!-- 工序说明 -->
  <view class="craft-desc">{{frames[currentFrame].desc}}</view>

  <!-- 底部 -->
  <view class="splash-footer">
    <view class="loading-hint">黄酒酿造中...</view>
    <view class="skip-btn" bindtap="onSkip">跳过 ›</view>
  </view>

</view>
