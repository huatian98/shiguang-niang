<view class="pay-page">
  <view class="navbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-back" bindtap="onBack">‹</view>
    <view class="nav-title">确认支付</view>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 米黄渐变金额 + 藏品信息合一卡 -->
  <view class="amount-card">
    <view class="amount-decor">🍷</view>

    <view class="amount-section">
      <view class="amount-label">待支付金额</view>
      <view class="amount-num">
        <text class="yen">¥</text><text class="num">{{price}}</text><text class="dec">.00</text>
      </view>
    </view>

    <view class="divider"></view>

    <view class="info-rows">
      <view class="info-row">
        <text class="info-label">藏品编号</text>
        <text class="info-value">{{code}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">产品名称</text>
        <text class="info-value">时光酿 · {{cellar}}</text>
      </view>
    </view>
  </view>

  <!-- 选择支付方式标题 -->
  <view class="section-head">
    <view class="bar"></view>
    <text>选择支付方式</text>
  </view>

  <!-- 双行支付方式 -->
  <view class="channel-list">
    <view class="channel {{channel === 'wechat' ? 'on' : ''}}" data-channel="wechat" bindtap="onSelectChannel">
      <view class="ch-icon wechat">
        <view class="ch-icon-symbol">💳</view>
      </view>
      <view class="ch-text">
        <view class="ch-name">微信支付</view>
        <view class="ch-sub">推荐拥有微信支付账号的用户使用</view>
      </view>
      <view class="ch-check {{channel === 'wechat' ? 'on' : ''}}">
        <text wx:if="{{channel === 'wechat'}}" class="check-mark">✓</text>
      </view>
    </view>
    <view class="channel {{channel === 'alipay' ? 'on' : ''}}" data-channel="alipay" bindtap="onSelectChannel">
      <view class="ch-icon alipay">
        <view class="ch-icon-symbol">💴</view>
      </view>
      <view class="ch-text">
        <view class="ch-name">支付宝</view>
        <view class="ch-sub">支持余额、余额宝、银行卡等支付</view>
      </view>
      <view class="ch-check {{channel === 'alipay' ? 'on' : ''}}">
        <text wx:if="{{channel === 'alipay'}}" class="check-mark">✓</text>
      </view>
    </view>
  </view>

  <!-- 酒窖装饰图 -->
  <view class="deco">
    <image class="deco-img" src="/images/decor/cellar-scene.png" mode="aspectFit" />
  </view>

  <!-- 立即支付 -->
  <view class="pay-btn-wrap">
    <button class="pay-btn" bindtap="onPay" loading="{{paying}}" disabled="{{paying}}">
      立即支付 ¥{{price}}.00
    </button>
    <view class="pay-tip">
      <text class="shield">⊘</text>
      <text class="tip-text">由 银联商务 提供加密支付保障</text>
    </view>
  </view>
</view>
