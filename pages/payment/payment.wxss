.pay-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  box-sizing: border-box;
  background: #F5F1E8;
}

.navbar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 30rpx;
  background: #F5F1E8;
}
.nav-back {
  font-size: 56rpx;
  color: #A02828;
  width: 60rpx;
  line-height: 1;
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  color: #8C2424;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.nav-placeholder { width: 60rpx; }

/* ============ 金额 + 藏品信息合一卡 ============ */
.amount-card {
  position: relative;
  margin: 24rpx 30rpx 36rpx;
  padding: 36rpx 30rpx 30rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #F4E6CB 0%, #EAD4A4 100%);
  box-shadow: 0 6rpx 20rpx rgba(140,100,40,0.12);
  overflow: hidden;
}
.amount-decor {
  position: absolute;
  top: 12rpx;
  right: 28rpx;
  font-size: 130rpx;
  color: rgba(0,0,0,0.06);
  pointer-events: none;
  line-height: 1;
}

.amount-section {
  text-align: center;
  position: relative;
  z-index: 2;
}
.amount-label {
  font-size: 24rpx;
  color: #6B5A4A;
  letter-spacing: 1rpx;
}
.amount-num {
  margin-top: 14rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  color: #8C2424;
  font-weight: 700;
}
.yen {
  font-size: 40rpx;
  margin-right: 4rpx;
}
.num {
  font-size: 80rpx;
  letter-spacing: 1rpx;
  line-height: 1;
}
.dec {
  font-size: 36rpx;
}

.divider {
  height: 1rpx;
  background: rgba(0,0,0,0.08);
  margin: 28rpx 0 24rpx;
  border-top: 1rpx dashed rgba(0,0,0,0.05);
}

.info-rows {
  position: relative;
  z-index: 2;
}
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}
.info-label {
  font-size: 26rpx;
  color: #6B5A4A;
}
.info-value {
  font-size: 28rpx;
  color: #2A2A2A;
  font-weight: 500;
}

/* ============ 选择支付方式 ============ */
.section-head {
  display: flex;
  align-items: center;
  margin: 0 30rpx 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #2A2A2A;
}
.bar {
  width: 6rpx;
  height: 28rpx;
  background: #A02828;
  margin-right: 12rpx;
}

.channel-list {
  margin: 0 30rpx;
}
.channel {
  display: flex;
  align-items: center;
  padding: 24rpx 26rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 18rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}
.channel.on {
  border-color: #A02828;
  background: #FFF8F0;
  box-shadow: 0 4rpx 14rpx rgba(140,36,36,0.1);
}

.ch-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}
.ch-icon.wechat {
  background: rgba(60,180,60,0.15);
}
.ch-icon.alipay {
  background: rgba(40,120,210,0.15);
}
.ch-icon-symbol {
  font-size: 36rpx;
}

.ch-text {
  flex: 1;
}
.ch-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2A2A2A;
  margin-bottom: 6rpx;
}
.ch-sub {
  font-size: 22rpx;
  color: #8B7A5A;
  letter-spacing: 0.5rpx;
}

.ch-check {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #C4B59A;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ch-check.on {
  border-color: #A02828;
  background: #A02828;
}
.check-mark {
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
}

/* ============ 装饰图 ============ */
.deco {
  display: flex;
  justify-content: center;
  margin: 50rpx 30rpx;
}
.deco-img {
  width: 420rpx;
  height: 360rpx;
  opacity: 0.85;
}

/* ============ 立即支付 ============ */
.pay-btn-wrap {
  margin: 30rpx;
}
.pay-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #A02828;
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  box-shadow: 0 8rpx 24rpx rgba(140,36,36,0.3);
}
.pay-btn::after { border: none; }
.pay-btn:active { transform: scale(0.98); }
.pay-btn[disabled] {
  background: #C4B59A;
  color: #fff;
}

.pay-tip {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #8B7A5A;
}
.shield {
  margin-right: 8rpx;
  font-size: 24rpx;
  color: #8B7A5A;
}
.tip-text {
  letter-spacing: 1rpx;
}
