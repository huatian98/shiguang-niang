.pay-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  box-sizing: border-box;
  background: #F5F1E8;
}

.navbar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 30rpx;
  background: #F5F1E8;
}
.nav-back {
  font-size: 56rpx;
  color: #A02828;
  width: 60rpx;
  line-height: 1;
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  color: #2A2A2A;
  font-weight: 600;
}
.nav-placeholder { width: 60rpx; }

/* 金额大卡 */
.amount-card {
  margin: 30rpx;
  padding: 40rpx 36rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #C73838 0%, #8C2424 60%, #6A1818 100%);
  box-shadow: 0 10rpx 28rpx rgba(140,36,36,0.3);
  color: #fff;
  position: relative;
  overflow: hidden;
}
.amount-card::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.06);
}
.amount-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
}
.amount-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  letter-spacing: 2rpx;
}
.amount-num {
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
}
.yen {
  font-size: 36rpx;
  margin-right: 6rpx;
}
.num {
  font-size: 80rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.dec {
  font-size: 32rpx;
  margin-left: 4rpx;
}
.amount-icon {
  font-size: 88rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.2));
}

/* 信息卡 */
.info-card {
  margin: 0 30rpx 30rpx;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed rgba(160,40,40,0.12);
}
.info-row:last-child { border-bottom: none; }
.info-label {
  font-size: 26rpx;
  color: #6B5A4A;
}
.info-value {
  font-size: 28rpx;
  color: #2A2A2A;
  font-weight: 600;
}
.info-value.sub {
  font-size: 24rpx;
  color: #8B7A5A;
  font-weight: 400;
}

/* section title */
.section-head {
  display: flex;
  align-items: center;
  margin: 0 30rpx 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #2A2A2A;
}
.bar {
  width: 6rpx;
  height: 26rpx;
  background: #A02828;
  margin-right: 12rpx;
}

/* 支付方式 */
.channel-list {
  margin: 0 30rpx 40rpx;
}
.channel {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}
.channel.on {
  border-color: #A02828;
  background: #FFF8F0;
}
.ch-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}
.ch-icon.wechat {
  background: rgba(60,180,60,0.12);
}
.ch-icon.alipay {
  background: rgba(40,120,210,0.12);
}
.ch-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: #2A2A2A;
}
.ch-radio {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #C4B59A;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.channel.on .ch-radio {
  border-color: #A02828;
}
.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #A02828;
}

/* 装饰 */
.deco {
  margin: 30rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #FAF1DC, #EFE2C0);
  border-radius: 16rpx;
  text-align: center;
}
.deco-jar {
  font-size: 100rpx;
  filter: drop-shadow(0 4rpx 12rpx rgba(140,36,36,0.2));
  animation: bob 3s ease-in-out infinite;
}
@keyframes bob {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-6rpx); }
}
.deco-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8B7A5A;
  letter-spacing: 4rpx;
}

/* 立即支付 */
.pay-btn-wrap {
  margin: 30rpx;
  padding-top: 20rpx;
}
.pay-btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background: #A02828;
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(140,36,36,0.3);
}
.pay-btn::after { border: none; }
.pay-btn:active { transform: scale(0.98); }
.pay-btn[disabled] {
  background: #C4B59A;
  color: #fff;
}
.pay-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8B7A5A;
}
